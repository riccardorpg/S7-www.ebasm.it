{# Toggle Azienda/Privato per i campi cliente. Param: prefix. #}
<script>
    window.clientFiscalToggle = window.clientFiscalToggle || function (prefix) {
        var type = document.getElementById(prefix + '_type');
        if (!type) return;
        var isAzienda = (type.value === 'aziendale');

        // Etichetta del campo nome.
        var lbl = document.getElementById(prefix + '_nameLabel');
        if (lbl) lbl.textContent = isAzienda ? 'Ragione sociale *' : 'Nome e cognome *';

        // P. IVA: presente solo per Azienda (svuotata se Privato).
        var vatWrap = document.getElementById(prefix + '_vatWrap');
        var vat = document.getElementById(prefix + '_vat');
        if (vatWrap) vatWrap.style.display = isAzienda ? '' : 'none';
        if (!isAzienda && vat) vat.value = '';

        // Ricalcolo colonne della riga 2 per arrivare a col-12:
        //  - con P.IVA: 4 campi → col-md-3;  - senza P.IVA: 3 campi → col-md-4.
        document.querySelectorAll('.' + prefix + '-fcol').forEach(function (c) {
            if (c === vatWrap) return;
            c.classList.remove('col-md-3', 'col-md-4');
            c.classList.add(isAzienda ? 'col-md-3' : 'col-md-4');
        });
    };
    document.addEventListener('DOMContentLoaded', function () { clientFiscalToggle('{{ prefix }}'); });
</script>
