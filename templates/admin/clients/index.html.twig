{% extends 'admin/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Clienti{% endblock %}
{% block page_title %}Gestione clienti{% endblock %}

{% block navbar_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('admin_index') }}">Torna alla scrivania</a></li>
{% endblock %}

{% block navbar_right %}
    <li class="nav-item"><a class="nav-link" href="{{ path('admin_client_new') }}">Nuovo</a></li>
{% endblock %}

{% block content %}
    <section class="content-wrap">
        <div class="container">
            {# Form filtri (GET) esterno alla tabella; gli input lo raggiungono via form="clientsFilter".
               Preserva l'ordinamento corrente con hidden sort/direction. #}
            <form id="clientsFilter" method="get" action="{{ path('admin_clients') }}">
                <input type="hidden" id="clientsFilter_sort" name="sort" value="{{ app.request.query.get('sort') }}">
                <input type="hidden" id="clientsFilter_direction" name="direction" value="{{ app.request.query.get('direction') }}">
            </form>

            <div class="card"><div class="card-body">
                <table class="table table-striped table-hover table-bordered align-middle m_b_none">
                    <thead>
                        <tr class="tr_filter">
                            <td class="txt_a_c">{{ ico.action(path('admin_clients'), 'close', 'Escludi filtro', 'red') }}</td>
                            {# Stato: multi-selezione #}
                            <td>
                                <input form="clientsFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_1" readonly onclick="filterMulti1()" placeholder="Tutti" autocomplete="off">
                                <input form="clientsFilter" type="hidden" id="filter_multi_id_1" name="f_status" value="{{ filters.status }}">
                            </td>
                            <td><input form="clientsFilter" name="f_name" value="{{ filters.name }}" class="form-control form-control-sm" placeholder="Filtra"></td>
                            {# Tipo: multi-selezione #}
                            <td>
                                <input form="clientsFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_2" readonly onclick="filterMulti2()" placeholder="Tutti" autocomplete="off">
                                <input form="clientsFilter" type="hidden" id="filter_multi_id_2" name="f_type" value="{{ filters.type }}">
                            </td>
                            {# Licenza: multi-selezione #}
                            <td>
                                <input form="clientsFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_3" readonly onclick="filterMulti3()" placeholder="Tutte" autocomplete="off">
                                <input form="clientsFilter" type="hidden" id="filter_multi_id_3" name="f_license" value="{{ filters.license }}">
                            </td>
                            {# Scadenza: daterange #}
                            <td><input form="clientsFilter" type="text" class="form-control form-control-sm daterange" id="daterange_clients" name="f_expiry" value="{{ filters.expiry }}" placeholder="Da/A" autocomplete="off"></td>
                            <td colspan="100%" class="text-nowrap">
                                <button form="clientsFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                    <img src="{{ asset(path_graphics ~ '/icons/search.png') }}" class="icon_action icon_green" alt="Filtra">
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <th class="td_w_60p"></th>
                            <th>{{ ico.sort('Stato', 'c.active') }}</th>
                            <th>{{ ico.sort('Ragione sociale / Nome', 'c.name') }}</th>
                            <th>{{ ico.sort('Tipo', 'c.clientType') }}</th>
                            <th>{{ ico.sort('Licenza', 'c.licenseType') }}</th>
                            <th>{{ ico.sort('Scadenza', 'c.licenseExpiresAt') }}</th>
                            <th class="text-center">Pratiche att./arch.</th>
                            <th>Spazio</th>
                            <th class="td_w_100p txt_a_c">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for c in records %}
                        {% set status = c.statusLabel %}
                        <tr>
                            <td class="txt_a_c">{{ ico.action(path('admin_client_show', {id: c.id}), 'view', 'Scheda', 'pr') }}</td>
                            <td><span class="badge {{ status == 'Attivo' ? 'bg-success' : (status == 'Demo' ? 'bg-info' : (status == 'Scaduto' ? 'bg-danger' : 'bg-secondary')) }}">{{ status }}</span></td>
                            <td><a href="{{ path('admin_client_show', {id: c.id}) }}">{{ c.name }}</a><div class="op_05 font_12">{{ c.code }}</div></td>
                            <td>{{ c.clientTypeLabel }}</td>
                            <td>{{ c.licenseTypeLabel }}</td>
                            <td>{{ c.licenseExpiresAt ? c.licenseExpiresAt|date('d/m/Y') : '—' }}</td>
                            <td class="text-center">— / —</td>
                            <td>
                                {% set used = storage[c.id]|default(0) %}
                                {{ used }} / {{ c.storageQuotaMb }} MB
                                {% set pct = c.storageQuotaMb > 0 ? (used / c.storageQuotaMb * 100)|round : 0 %}
                                <div class="progress" style="height:4px;"><div class="progress-bar {{ pct > 90 ? 'bg-danger' : '' }}" style="width:{{ pct > 100 ? 100 : pct }}%;"></div></div>
                            </td>
                            <td class="txt_a_c text-nowrap">
                                <a href="javascript:void(0)" class="d-inline-block m_r_5p" data-bs-toggle="tooltip" data-bs-title="Modifica"
                                   onclick="clientEditOpen(this)"
                                   data-id="{{ c.id }}" data-name="{{ c.name }}" data-type="{{ c.clientType }}"
                                   data-vat="{{ c.vatNumber }}" data-tax="{{ c.taxCode }}" data-address="{{ c.address }}"
                                   data-civic="{{ c.civic }}" data-sdi="{{ c.sdi }}" data-pec="{{ c.pec }}"
                                   data-cityid="{{ c.city ? c.city.id : '' }}" data-cityname="{{ c.city ? c.city : '' }}" data-zipid="{{ c.zip ? c.zip.id : '' }}">
                                    <img src="{{ asset(path_graphics ~ '/icons/edit.png') }}" class="icon_action icon_amber" alt="Modifica">
                                </a>
                                {% if c.canDelete %}
                                    {{ ico.action("javascript:clientDelete('" ~ path('admin_client_delete', {id: c.id}) ~ "')", 'delete', 'Elimina', 'red') }}
                                {% else %}
                                    {{ ico.disabled('delete-grey', 'Sospendi il cliente per poterlo eliminare') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="9" class="op_07 text-center">Nessun cliente trovato.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% include 'components/table/paginator.html.twig' with {records: records} only %}
            </div></div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% embed 'components/modals/form_modal.html.twig' with {type: 'clientEdit', title: 'Modifica cliente', size: 'modal-lg'} %}
        {% block modalBody %}
            <div class="row g-3">
                <div class="col-md-8"><label class="form-label">Ragione sociale / Nome e cognome *</label><input type="text" name="name" class="form-control" required></div>
                <div class="col-md-4"><label class="form-label">Tipo cliente</label>
                    <select name="client_type" class="form-select">
                        <option value="aziendale">Aziendale</option>
                        <option value="professionista">Professionista</option>
                    </select>
                </div>
                <div class="col-md-4"><label class="form-label">P. IVA</label><input type="text" name="vat_number" class="form-control"></div>
                <div class="col-md-4"><label class="form-label">Codice fiscale</label><input type="text" name="tax_code" class="form-control"></div>
                <div class="col-md-4"><label class="form-label">PEC</label><input type="email" name="pec" class="form-control"></div>
                <div class="col-md-6"><label class="form-label">Indirizzo</label><input type="text" name="address" class="form-control"></div>
                <div class="col-md-2"><label class="form-label">Civico</label><input type="text" name="civic" class="form-control"></div>
                <div class="col-md-2"><label class="form-label">SDI</label><input type="text" name="sdi" class="form-control" maxlength="7"></div>
                {% include 'admin/clients/_city_picker.html.twig' with {formName: 'clientEdit', number: 1} only %}
            </div>
        {% endblock %}
    {% endembed %}

    {% include 'components/modals/delete_modal.html.twig' with {type: 'client', title: 'Cliente', text: 'eliminerai il cliente e il suo database'} %}

    {% include 'components/modals/filter_multi.html.twig' with {number: 1, title: 'Filtra per stato', options: [
        {id: 'attivo', label: 'Attivo'}, {id: 'demo', label: 'Demo'}, {id: 'scaduto', label: 'Scaduto'}, {id: 'sospeso', label: 'Sospeso'}
    ]} only %}
    {% include 'components/modals/filter_multi.html.twig' with {number: 2, title: 'Filtra per tipo', options: [
        {id: 'aziendale', label: 'Aziendale'}, {id: 'professionista', label: 'Professionista'}
    ]} only %}
    {% include 'components/modals/filter_multi.html.twig' with {number: 3, title: 'Filtra per licenza', options: [
        {id: 'demo', label: 'Demo'}, {id: 'base', label: 'Base'}, {id: 'pro', label: 'Pro'}, {id: 'enterprise', label: 'Enterprise'}
    ]} only %}

    {% include 'components/modals/city.html.twig' with {number: 1, cities: []} only %}
{% endblock %}

{% block page_javascripts %}
<script>
    var CLIENT_BASE = "{{ path('admin_clients') }}";
    function clientEditOpen(el) {
        var f = document.getElementById('clientEditForm'), d = el.dataset;
        f.action = CLIENT_BASE + '/' + d.id + '/modifica';
        f.querySelector('[name="name"]').value = d.name || '';
        f.querySelector('[name="client_type"]').value = d.type || 'aziendale';
        f.querySelector('[name="vat_number"]').value = d.vat || '';
        f.querySelector('[name="tax_code"]').value = d.tax || '';
        f.querySelector('[name="pec"]').value = d.pec || '';
        f.querySelector('[name="address"]').value = d.address || '';
        f.querySelector('[name="civic"]').value = d.civic || '';
        f.querySelector('[name="sdi"]').value = d.sdi || '';
        // Città/CAP: prefill del picker + caricamento CAP preservando quello salvato.
        document.getElementById('clientEdit_city').value = d.cityid || '';
        document.getElementById('clientEdit_cityName').value = d.cityname || '';
        document.getElementById('clientEdit_zip').value = d.zipid || '';
        if (window.zipUpdateSelect1) { zipUpdateSelect1(true); }
        clientEditShow();
    }
</script>
{% include 'components/table/sort_js.html.twig' with {
    formName: 'clientsFilter', sortId: 'clientsFilter_sort', directionId: 'clientsFilter_direction',
    actualSort: app.request.query.get('sort'), actualDirection: app.request.query.get('direction')
} only %}
{% include 'components/js/daterangepicker_js.html.twig' with {id: 'daterange_clients', hasTimePicker: 'false', format: 'DD-MM-YYYY'} %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 1} only %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 2} only %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 3} only %}
{% include 'components/js/city_js.html.twig' with {number: 1, formName: 'clientEdit', modalToClose: 'clientEditModal'} only %}
{% endblock %}
