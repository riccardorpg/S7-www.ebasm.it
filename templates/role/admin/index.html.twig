{% extends 'role/admin/layout.html.twig' %}

{% block title %} - Amministrazione{% endblock %}
{% block role_page_title_inner %}Dashboard{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <div class="row col-mb-30">
                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h4>Benvenuto, {{ app.user.fullName }}</h4>
                            <p class="op_07">Ruolo: <span class="badge bg-success">Amministratore</span></p>
                            <a href="{{ path('admin_agencies') }}" class="button button-3d button-small button-green m_t_10p">
                                <i class="bi-building"></i> Gestione agenzie &amp; impersonazione
                            </a>
                        </div>
                    </div>
                </div>

                <div class="col-12">
                    <div class="card">
                        <div class="card-body">
                            <h5>Agenzie registrate</h5>
                            {% if companies is empty %}
                                <p class="op_07 m_b_none">Nessuna agenzia registrata. Creane una con <code>php bin/console app:create-agency</code>.</p>
                            {% else %}
                                <table class="table table-striped m_b_none">
                                    <thead><tr><th>Codice</th><th>Nome</th><th>Database</th><th>Stato</th></tr></thead>
                                    <tbody>
                                        {% for company in companies %}
                                            <tr>
                                                <td>{{ company.code }}</td>
                                                <td>{{ company.name }}</td>
                                                <td class="op_07">{{ company.dbName }}</td>
                                                <td>{{ company.active ? 'Attiva' : 'Sospesa' }}</td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
