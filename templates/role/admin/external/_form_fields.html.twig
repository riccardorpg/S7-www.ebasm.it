<div class="row g-3">
    <div class="col-md-6"><label class="form-label">Nome *</label><input type="text" name="name" class="form-control" required></div>
    <div class="col-md-6"><label class="form-label">Cognome *</label><input type="text" name="surname" class="form-control" required></div>
    <div class="col-md-6"><label class="form-label">E-mail *</label><input type="email" name="email" class="form-control" required></div>
    <div class="col-md-6"><label class="form-label">Telefono</label><input type="text" name="phone" class="form-control"></div>
    <div class="col-12 position-relative">
        <label class="form-label">Studio notarile di riferimento</label>
        {# Autocomplete inline: i risultati appaiono sotto il campo (via JS), niente modale. #}
        <input type="text" id="{{ prefix }}_companyName" class="form-control" placeholder="Digita nome o codice…" autocomplete="off"
               oninput="companySearch('{{ prefix }}')" onfocus="companySearch('{{ prefix }}')">
        <input type="hidden" id="{{ prefix }}_company" name="company_id" value="">
        <ul id="{{ prefix }}_companyResults" class="list-group position-absolute w-100 shadow-sm" style="z-index:1085; max-height:220px; overflow-y:auto; display:none;"></ul>
    </div>
</div>
