{% extends 'role/admin/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Account esterni{% endblock %}
{% block role_page_title_inner %}Account esterni{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('admin_index') }}">Torna alla scrivania</a></li>
{% endblock %}

{% block sub_menu_right %}
    <li class="nav-item"><a class="nav-link" href="javascript:externalNewShow()">Nuovo</a></li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <form id="externalFilter" method="get" action="{{ path('admin_external_accounts') }}">
                <input type="hidden" id="externalFilter_sort" name="sort" value="{{ app.request.query.get('sort') }}">
                <input type="hidden" id="externalFilter_direction" name="direction" value="{{ app.request.query.get('direction') }}">
            </form>

            <div>
                <table class="table table-hover table-bordered align-middle m_b_none">
                    <thead>
                        <tr class="tr_filter">
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    {{ ico.action(path('admin_external_accounts'), 'close', 'Escludi filtro', 'red') }}
                                    <input form="externalFilter" name="f_name" value="{{ filters.name }}" class="form-control form-control-sm" placeholder="Filtra">
                                </div>
                            </td>
                            <td><input form="externalFilter" name="f_surname" value="{{ filters.surname }}" class="form-control form-control-sm" placeholder="Filtra"></td>
                            <td><input form="externalFilter" name="f_email" value="{{ filters.email }}" class="form-control form-control-sm" placeholder="Filtra"></td>
                            <td><input form="externalFilter" name="f_phone" value="{{ filters.phone }}" class="form-control form-control-sm" placeholder="Filtra"></td>
                            <td>
                                <input form="externalFilter" type="text" class="form-control form-control-sm cursor_p" id="filter_multi_value_1" readonly onclick="filterMulti1()" placeholder="Tutti" autocomplete="off">
                                <input form="externalFilter" type="hidden" id="filter_multi_id_1" name="f_company" value="{{ filters.company }}">
                            </td>
                            <td class="txt_a_c text-nowrap">
                                <button form="externalFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/search.png') }}" class="icon_action icon_green" alt="Filtra">
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <th>{{ ico.sort('Nome', 'a.name') }}</th>
                            <th>{{ ico.sort('Cognome', 'a.surname') }}</th>
                            <th>{{ ico.sort('E-mail', 'a.email') }}</th>
                            <th>{{ ico.sort('Telefono', 'a.phone') }}</th>
                            <th>{{ ico.sort('Studio notarile di riferimento', 'co.name') }}</th>
                            <th class="td_w_100p txt_a_c">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for a in records %}
                        <tr>
                            <td>{{ a.name }}</td>
                            <td>{{ a.surname }}</td>
                            <td>{{ a.email }}</td>
                            <td>{{ a.phone ?? '—' }}</td>
                            <td>{{ a.company ? a.company.name : '—' }}</td>
                            <td class="txt_a_c text-nowrap">
                                <a href="javascript:void(0)" class="d-inline-block m_r_5p" data-bs-toggle="tooltip" data-bs-title="Modifica"
                                   onclick="externalEditOpen(this)"
                                   data-id="{{ a.id }}" data-name="{{ a.name }}" data-surname="{{ a.surname }}"
                                   data-email="{{ a.email }}" data-phone="{{ a.phone }}"
                                   data-company="{{ a.company ? a.company.id : '' }}" data-companyname="{{ a.company ? a.company.name ~ ' (' ~ a.company.code ~ ')' : '' }}">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/edit.png') }}" class="icon_action icon_amber" alt="Modifica">
                                </a>
                                {% if a.canDelete %}
                                    {{ ico.action("javascript:externalDelete('" ~ path('admin_external_account_delete', {id: a.id}) ~ "')", 'delete', 'Elimina', 'red') }}
                                {% else %}
                                    {{ ico.disabled('delete-grey', 'Non eliminabile') }}
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="6" class="op_07 text-center">Nessun account esterno trovato.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% include 'components/table/paginator.html.twig' with {records: records} only %}
            </div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {# NUOVO #}
    {% embed 'components/modals/form_modal.html.twig' with {type: 'externalNew', title: 'Nuovo account esterno', action: path('admin_external_account_new')} %}
        {% block modalBody %}{{ include('role/admin/external/_form_fields.html.twig', {prefix: 'extNew'}) }}{% endblock %}
        {% block modalSubmit %}Crea{% endblock %}
    {% endembed %}

    {# MODIFICA #}
    {% embed 'components/modals/form_modal.html.twig' with {type: 'externalEdit', title: 'Modifica account esterno'} %}
        {% block modalBody %}{{ include('role/admin/external/_form_fields.html.twig', {prefix: 'extEdit'}) }}{% endblock %}
    {% endembed %}

    {% include 'components/modals/delete_modal.html.twig' with {type: 'external', title: 'Account esterno', text: 'eliminerai l\'account esterno selezionato'} %}

    {% include 'components/modals/filter_multi.html.twig' with {number: 1, title: 'Filtra per studio notarile', options: companies|map(c => {'id': c.id, 'label': c.name})} only %}
{% endblock %}

{% block page_javascripts %}
<script>
    var EXT_BASE = "{{ path('admin_external_accounts') }}";
    function externalEditOpen(el) {
        var f = document.getElementById('externalEditForm');
        f.action = EXT_BASE + '/' + el.dataset.id + '/modifica';
        f.querySelector('[name="name"]').value = el.dataset.name || '';
        f.querySelector('[name="surname"]').value = el.dataset.surname || '';
        f.querySelector('[name="email"]').value = el.dataset.email || '';
        f.querySelector('[name="phone"]').value = el.dataset.phone || '';
        document.getElementById('extEdit_company').value = el.dataset.company || '';
        document.getElementById('extEdit_companyName').value = el.dataset.companyname || '';
        externalEditShow();
    }
</script>
{% include 'components/table/sort_js.html.twig' with {
    formName: 'externalFilter', sortId: 'externalFilter_sort', directionId: 'externalFilter_direction',
    actualSort: app.request.query.get('sort'), actualDirection: app.request.query.get('direction')
} only %}
{% include 'components/js/filter_multi_js.html.twig' with {number: 1} only %}
{% include 'role/admin/external/_company_autocomplete.html.twig' %}
{% endblock %}
