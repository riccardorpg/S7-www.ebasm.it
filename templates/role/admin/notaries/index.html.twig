{% extends 'role/admin/layout.html.twig' %}
{% import 'components/action_icons.html.twig' as ico %}

{% block title %} - Notai{% endblock %}
{% block role_page_title_inner %}Gestione notai{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('admin_index') }}">Torna alla scrivania</a></li>
{% endblock %}

{% block sub_menu_right %}
    <li class="nav-item"><a class="nav-link" href="javascript:notaryNewShow()">Nuovo</a></li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('admin_index') }}">Amministrazione</a></li>
    <li class="breadcrumb-item active" aria-current="page">Notai</li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <form id="notariesFilter" method="get" action="{{ path('admin_notaries') }}">
                <input type="hidden" id="notariesFilter_sort" name="sort" value="{{ app.request.query.get('sort') }}">
                <input type="hidden" id="notariesFilter_direction" name="direction" value="{{ app.request.query.get('direction') }}">
            </form>

            <div>
                <table class="table table-hover table-bordered align-middle m_b_none">
                    <thead>
                        <tr class="tr_filter">
                            {# 1 Notaio (con Escludi filtro a sx) #}
                            <td>
                                <div class="d-flex align-items-center gap-1">
                                    {{ ico.action(path('admin_notaries'), 'close', 'Azzera filtri', 'red') }}
                                    <input form="notariesFilter" name="f_q" value="{{ filters.q }}" class="form-control form-control-sm" placeholder="Nome, cognome…">
                                </div>
                            </td>
                            {# 2 E-mail #}
                            <td><input form="notariesFilter" name="f_email" value="{{ filters.email }}" class="form-control form-control-sm" placeholder="Filtra"></td>
                            {# 3 Agenzia #}
                            <td>
                                <select form="notariesFilter" name="f_agency" class="form-select form-select-sm">
                                    <option value="">Tutte</option>
                                    {% for c in companies %}
                                        <option value="{{ c.id }}" {{ filters.agency == c.id ? 'selected' : '' }}>{{ c.code }} — {{ c.name }}</option>
                                    {% endfor %}
                                </select>
                            </td>
                            {# 4 Azioni: filtra a dx #}
                            <td class="txt_a_c text-nowrap">
                                <button form="notariesFilter" type="submit" class="btn p-0 border-0 bg-transparent" data-bs-toggle="tooltip" data-bs-title="Filtra">
                                    <img src="{{ asset(PATH_GRAPHICS ~ 'icons/search.png') }}" class="icon_action icon_green" alt="Filtra">
                                </button>
                            </td>
                        </tr>
                        <tr>
                            <th class="td_w_200p">{{ ico.sort('Notaio', 'u.surname') }}</th>
                            <th class="td_w_200p">{{ ico.sort('E-mail', 'u.email') }}</th>
                            <th class="td_w_200p">Agenzie abilitate</th>
                            <th class="td_w_100p txt_a_c">Azioni</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for n in records %}
                        <tr>
                            <td>{{ n.fullName }}</td>
                            <td>{{ n.email }}</td>
                            <td>
                                {% if n.companies|length %}
                                    {% for c in n.companies %}<span class="badge bg-secondary">{{ c.code }}</span> - {{ c.name }}{% if not loop.last %}<br>{% endif %}{% endfor %}
                                {% else %}
                                    <span class="op_07">Nessuna</span>
                                {% endif %}
                            </td>
                            <td class="txt_a_c text-nowrap">
                                {% set ids = [] %}
                                {% for c in n.companies %}{% set ids = ids|merge([c.id]) %}{% endfor %}
                                {{ ico.action("javascript:notaryEditShow(" ~ path('admin_notary_edit', {id: n.id})|json_encode ~ ", " ~ n.name|default('')|json_encode ~ ", " ~ n.surname|default('')|json_encode ~ ", " ~ n.email|json_encode ~ ")", 'edit', 'Modifica dati', 'pr') }}
                                {{ ico.action("javascript:notaryAgenciesShow(" ~ path('admin_notary_agencies', {id: n.id})|json_encode ~ ", " ~ ids|json_encode ~ ", " ~ n.fullName|json_encode ~ ")", 'binded', 'Modifica agenzie', 'pr') }}
                                {{ ico.action("javascript:notaryCredConfirm(" ~ path('admin_notary_credentials', {id: n.id})|json_encode ~ ", " ~ csrf_token('notaryCredentials')|json_encode ~ ", " ~ ('invierai le credenziali di accesso a ' ~ n.email)|json_encode ~ ")", 'send', 'Invia credenziali', 'pr') }}
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="op_07 text-center">Nessun notaio trovato.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
                {% include 'components/table/paginator.html.twig' with {records: records} only %}
            </div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {# Conferma invio credenziali #}
    {% include 'components/modals/confirm_modal.html.twig' with {type: 'notaryCred', title: 'Invia credenziali'} only %}

    {# Nuovo notaio #}
    {% embed 'components/modals/form_modal.html.twig' with {type: 'notaryNew', title: 'Nuovo notaio', action: path('admin_notary_new')} %}
        {% block modalBody %}
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">Nome *</label><input type="text" name="name" class="form-control" required></div>
                <div class="col-md-6"><label class="form-label">Cognome *</label><input type="text" name="surname" class="form-control" required></div>
                <div class="col-12"><label class="form-label">E-mail *</label><input type="email" name="email" class="form-control" required></div>
            </div>
        {% endblock %}
        {% block modalSubmit %}Crea{% endblock %}
    {% endembed %}

    {# Modifica dati notaio (prefill via JS) #}
    <div id="notaryEditModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <form id="notaryEditForm" method="post" action="">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('notaryEdit') }}">
                    <div class="modal-header"><h3 class="modal-title">Modifica dati notaio</h3></div>
                    <div class="modal-stripe"></div>
                    <div class="modal-body">
                        <div class="row g-3">
                            <div class="col-md-6"><label class="form-label">Nome *</label><input type="text" id="notaryEdit_name" name="name" class="form-control" required></div>
                            <div class="col-md-6"><label class="form-label">Cognome *</label><input type="text" id="notaryEdit_surname" name="surname" class="form-control" required></div>
                            <div class="col-12"><label class="form-label">E-mail *</label><input type="email" id="notaryEdit_email" name="email" class="form-control" required></div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="button button-3d button-small button-red f_left" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="button button-3d button-small button-green f_right">Salva</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div id="notaryAgenciesModal" class="modal fade" tabindex="-1" role="dialog">
        <div class="modal-dialog modal-lg" role="document">
            <div class="modal-content">
                <form id="notaryAgenciesForm" method="post" action="">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('notaryAgencies') }}">
                    <div class="modal-header"><h3 class="modal-title">Agenzie abilitate — <span id="notaryAgenciesName" style="color:inherit"></span></h3></div>
                    <div class="modal-stripe"></div>
                    <div class="modal-body">
                        <p class="op_07">Seleziona le agenzie che il notaio può vedere e gestire.</p>
                        <div class="row g-2">
                        {% for c in companies %}
                            <div class="col-12">
                                <label class="d-flex align-items-center gap-2 p-1 m_b_none">
                                    <input type="checkbox" class="notaryAgencyCb form-check-input m_b_none" name="company_ids[]" value="{{ c.id }}">
                                    <span><span class="badge bg-secondary">{{ c.code }}</span> {{ c.name }}</span>
                                </label>
                            </div>
                        {% else %}
                            <div class="col-12 op_07">Nessuna agenzia attiva.</div>
                        {% endfor %}
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="button button-3d button-small button-red f_left" data-bs-dismiss="modal">Annulla</button>
                        <button type="submit" class="button button-3d button-small button-green f_right">Salva</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
{% endblock %}

{% block page_javascripts %}
    {% include 'components/table/sort_js.html.twig' with {
        formName: 'notariesFilter', sortId: 'notariesFilter_sort', directionId: 'notariesFilter_direction',
        actualSort: app.request.query.get('sort'), actualDirection: app.request.query.get('direction')
    } only %}
    <script>
        // I modali sono in #divModals, renderizzato DOPO questo blocco: inizializzo al DOMContentLoaded.
        document.addEventListener('DOMContentLoaded', function () {
            var agEl = document.getElementById('notaryAgenciesModal');
            if (agEl) {
                var agModal = new bootstrap.Modal(agEl, {backdrop: 'static', keyboard: false});
                window.notaryAgenciesShow = function (url, selectedIds, name) {
                    document.getElementById('notaryAgenciesForm').action = url;
                    document.getElementById('notaryAgenciesName').textContent = name || '';
                    var ids = (selectedIds || []).map(String);
                    document.querySelectorAll('.notaryAgencyCb').forEach(function (cb) {
                        cb.checked = ids.indexOf(cb.value) !== -1;
                    });
                    agModal.show();
                };
            }

            var edEl = document.getElementById('notaryEditModal');
            if (edEl) {
                var edModal = new bootstrap.Modal(edEl, {backdrop: 'static', keyboard: false});
                window.notaryEditShow = function (url, name, surname, email) {
                    document.getElementById('notaryEditForm').action = url;
                    document.getElementById('notaryEdit_name').value = name || '';
                    document.getElementById('notaryEdit_surname').value = surname || '';
                    document.getElementById('notaryEdit_email').value = email || '';
                    edModal.show();
                };
            }
        });
    </script>
{% endblock %}
