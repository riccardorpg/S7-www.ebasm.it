{% extends 'role/admin/layout.html.twig' %}

{% block title %} - Nuovo cliente{% endblock %}
{% block role_page_title_inner %}{{ demoRequest ? 'Nuovo cliente da richiesta demo' : 'Nuovo cliente' }}{% endblock %}

{% block sub_menu_left %}
    {% if demoRequest %}
        <li class="nav-item"><a class="nav-link" href="{{ path('admin_index') }}">Torna alla scrivania</a></li>
    {% else %}
        <li class="nav-item"><a class="nav-link" href="{{ path('admin_clients') }}">Torna alla lista</a></li>
    {% endif %}
{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('admin_index') }}">Amministrazione</a></li>
    <li class="breadcrumb-item"><a href="{{ path('admin_clients') }}">Clienti</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nuovo</li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <div class="card">
                <div class="card-body p-4">
                    <form method="post" action="{{ path('admin_client_new', demoRequest ? {from: demoRequest.id} : {}) }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('client_new') }}">
                        {% if demoRequest %}
                            <input type="hidden" name="from" value="{{ demoRequest.id }}">

                            <div class="alert alert-info">
                                Dati precompilati dalla richiesta del
                                <strong>{{ demoRequest.createdAt ? demoRequest.createdAt|date('d/m/Y H:i') : '' }}</strong>
                                ({{ demoRequest.email }}). Al salvataggio la richiesta viene marcata come evasa,
                                la licenza parte come <strong>demo di 30 giorni</strong> e viene creato il primo
                                utente dell'agenzia.
                            </div>
                        {% endif %}

                        <h5 class="mb-3">Dati cliente</h5>
                        <div class="mb-4">
                            {% include 'role/admin/clients/_fiscal_fields.html.twig' with {prefix: 'clientNew', company: prefill, codeEditable: true} only %}
                        </div>

                        {# 7.1.10.2 Nome del database #}
                        <h5 class="mb-3">Database dedicato</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Nome del database *</label>
                                <input type="text" name="db_name" class="form-control" placeholder="es. ebasm_ag_ag003" required>
                                <div class="form-text">Verrà creato un database MySQL dedicato con lo schema dell'agenzia.</div>
                            </div>
                        </div>

                        {% if demoRequest %}
                            {# Primo utente dell'agenzia: e-mail vincolata a quella della richiesta. #}
                            <h5 class="mb-3">Primo utente dell'agenzia</h5>
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <label class="form-label">Nome *</label>
                                    <input type="text" name="staff_name" class="form-control" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Cognome *</label>
                                    <input type="text" name="staff_surname" class="form-control" required>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">E-mail</label>
                                    <input type="email" class="form-control" value="{{ demoRequest.email }}" readonly disabled>
                                    <div class="form-text">Presa dalla richiesta. Nasce come amministratore dell'agenzia.</div>
                                </div>
                            </div>
                        {% endif %}

                        <a href="{{ demoRequest ? path('admin_index') : path('admin_clients') }}" class="button button-3d button-small button-red m_b_none">Annulla</a>
                        <button type="submit" class="button button-3d button-small button-green m_b_none f_right">Inserisci</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% include 'components/modals/city.html.twig' with {number: 1, cities: []} only %}
{% endblock %}

{% block page_javascripts %}
    {% include 'components/js/city_js.html.twig' with {number: 1, formName: 'clientNew', modalToClose: ''} only %}
    {% include 'role/admin/clients/_fiscal_js.html.twig' with {prefix: 'clientNew'} only %}
{% endblock %}
