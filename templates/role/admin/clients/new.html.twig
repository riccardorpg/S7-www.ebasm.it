{% extends 'role/admin/layout.html.twig' %}

{% block title %} - Nuovo cliente{% endblock %}
{% block role_page_title_inner %}Nuovo cliente{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('admin_clients') }}">Torna alla lista</a></li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('admin_index') }}">Amministrazione</a></li>
    <li class="breadcrumb-item"><a href="{{ path('admin_clients') }}">Clienti</a></li>
    <li class="breadcrumb-item active" aria-current="page">Nuovo</li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            <div class="card">
                <div class="card-body p-4">
                    <form method="post" action="{{ path('admin_client_new') }}">
                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('client_new') }}">

                        <h5 class="mb-3">Dati cliente</h5>
                        <div class="mb-4">
                            {% include 'role/admin/clients/_fiscal_fields.html.twig' with {prefix: 'clientNew', company: null, codeEditable: true} only %}
                        </div>

                        {# 7.1.10.2 Nome del database #}
                        <h5 class="mb-3">Database dedicato</h5>
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label class="form-label">Nome del database *</label>
                                <input type="text" name="db_name" class="form-control" placeholder="es. ebasm_ag_ag003" required>
                                <div class="form-text">Verrà creato un database MySQL dedicato con lo schema dell'agenzia.</div>
                            </div>
                        </div>

                        <a href="{{ path('admin_clients') }}" class="button button-3d button-small button-red m_b_none">Annulla</a>
                        <button type="submit" class="button button-3d button-small button-green m_b_none f_right">Inserisci</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% include 'components/modals/city.html.twig' with {number: 1, cities: []} only %}
{% endblock %}

{% block page_javascripts %}
    {% include 'components/js/city_js.html.twig' with {number: 1, formName: 'clientNew', modalToClose: ''} only %}
    {% include 'role/admin/clients/_fiscal_js.html.twig' with {prefix: 'clientNew'} only %}
{% endblock %}
