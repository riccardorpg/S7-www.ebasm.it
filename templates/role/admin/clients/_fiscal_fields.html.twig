{# Campi cliente (condiviso tra "Nuovo" e modale "Modifica").
   Parametri: prefix (es. 'clientNew'/'clientEdit'), company (nullable), codeEditable (bool).
   Il comportamento Azienda/Privato è gestito da _fiscal_js.html.twig (clientFiscalToggle). #}
{% set isPro = company and company.clientType == 'professionista' %}
<div class="row g-3">
    {# Riga 1: Codice, Tipo, Ragione sociale/Nome #}
    <div class="col-md-3">
        <label class="form-label">Codice cliente{{ codeEditable ? ' *' : '' }}</label>
        {% if codeEditable %}
            <input type="text" name="code" class="form-control text-uppercase" placeholder="ES. AG003" required>
        {% else %}
            <input type="text" class="form-control text-uppercase" value="{{ company.code }}" readonly disabled>
        {% endif %}
    </div>
    <div class="col-md-3">
        <label class="form-label">Tipo cliente</label>
        <select name="client_type" id="{{ prefix }}_type" class="form-select" onchange="clientFiscalToggle('{{ prefix }}')">
            <option value="aziendale" {{ isPro ? '' : 'selected' }}>Azienda</option>
            <option value="professionista" {{ isPro ? 'selected' : '' }}>Privato</option>
        </select>
    </div>
    <div class="col-md-6">
        <label class="form-label" id="{{ prefix }}_nameLabel">Ragione sociale *</label>
        <input type="text" name="name" class="form-control" value="{{ company ? company.name : '' }}" required>
    </div>

    {# Riga 2: P.IVA (solo Azienda), Codice fiscale, PEC, Codice SDI — col ricalcolate via JS #}
    <div class="col-md-3 {{ prefix }}-fcol" id="{{ prefix }}_vatWrap">
        <label class="form-label">P. IVA</label>
        <input type="text" name="vat_number" id="{{ prefix }}_vat" class="form-control" value="{{ company ? company.vatNumber : '' }}">
    </div>
    <div class="col-md-3 {{ prefix }}-fcol"><label class="form-label">Codice fiscale</label><input type="text" name="tax_code" class="form-control" value="{{ company ? company.taxCode : '' }}"></div>
    <div class="col-md-3 {{ prefix }}-fcol"><label class="form-label">PEC</label><input type="email" name="pec" class="form-control" value="{{ company ? company.pec : '' }}"></div>
    <div class="col-md-3 {{ prefix }}-fcol"><label class="form-label">Codice SDI</label><input type="text" name="sdi" class="form-control" maxlength="7" value="{{ company ? company.sdi : '' }}"></div>

    {# Riga 3: Indirizzo + Civico #}
    <div class="col-md-9"><label class="form-label">Indirizzo</label><input type="text" name="address" class="form-control" value="{{ company ? company.address : '' }}"></div>
    <div class="col-md-3"><label class="form-label">Civico</label><input type="text" name="civic" class="form-control" value="{{ company ? company.civic : '' }}"></div>

    {# Riga 4: Città + CAP #}
    {% include 'components/geo/city_picker.html.twig' with {
        formName: prefix, number: 1,
        cityId: company and company.city ? company.city.id : '',
        cityName: company and company.city ? company.city : '',
        zipId: company and company.zip ? company.zip.id : ''
    } only %}
</div>
