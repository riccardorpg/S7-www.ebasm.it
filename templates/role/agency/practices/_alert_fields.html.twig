{# 12.3.4.2 Campi dell'avviso: data del promemoria e messaggio. #}
<div class="row g-3">
    <div class="col-md-5">
        <label class="form-label" for="{{ prefix }}_remind_at">Ricorda in data *</label>
        <input type="text" id="{{ prefix }}_remind_at" name="remind_at" class="form-control"
               placeholder="gg-mm-aaaa" autocomplete="off" required>
    </div>
    <div class="col-12">
        <label class="form-label" for="{{ prefix }}_message">Messaggio *</label>
        <textarea id="{{ prefix }}_message" name="message" rows="3" class="form-control" required></textarea>
    </div>
</div>

<script>
    (function () {
        var jq = window.jQuery;
        if (!jq || typeof jq.fn.datepicker !== 'function') return;
        jq('#{{ prefix }}_remind_at').datepicker({
            format: 'dd-mm-yyyy',
            weekStart: 1,
            autoclose: true,
            todayHighlight: true,
            container: '#{{ prefix }}Modal'
        });
    })();
</script>
