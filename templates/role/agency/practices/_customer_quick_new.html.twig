{# =====================================================================
   12.2.1 / 12.2.2 Nuovo cliente "al volo" dal form della pratica.

   Il "+" accanto a venditore e acquirente apre questo modale: i dati vanno in POST
   su agency_customer_quick_new (JSON), il cliente creato viene scritto nel campo che
   ha chiesto l'inserimento e la pratica in compilazione resta com'era.

   Variabili (include ... only):
     prefix       : prefisso dei campi del form pratica (es. 'practiceNew')
     modalToClose : id del modale padre da chiudere/riaprire ('' se il form è in pagina)

   Il modale vive in #divModals, fuori dal form della pratica: il suo <form> non è
   annidato in quello della pratica.
   ===================================================================== #}
<div id="quickCustomerModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <form id="quickCustomerForm" method="post" action="{{ path('agency_customer_quick_new') }}" novalidate>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('customerQuickNew') }}">
                <div class="modal-header"><h3 class="modal-title">Nuovo cliente — <span id="quickCustomerRole" style="color:inherit"></span></h3></div>
                <div class="modal-stripe"></div>
                <div class="modal-body">
                    <div id="quickCustomerError" class="alert alert-danger d-none"></div>
                    {{ include('role/agency/customers/_form_fields.html.twig', {prefix: 'quickCustomer'}, with_context = false) }}
                </div>
                <div class="modal-footer">
                    <button type="button" class="button button-3d button-small button-red f_left" onclick="quickCustomerCancel()">Annulla</button>
                    <button type="submit" class="button button-3d button-small button-green f_right">Crea e seleziona</button>
                </div>
            </form>
        </div>
    </div>
</div>
<script>
    // Il modale è renderizzato in #divModals, dopo il blocco dei javascripts.
    document.addEventListener('DOMContentLoaded', function () {
        var el = document.getElementById('quickCustomerModal');
        if (!el) return;

        var modal = bootstrap.Modal.getOrCreateInstance(el, {backdrop: 'static', keyboard: false});
        var form = document.getElementById('quickCustomerForm');
        var errorBox = document.getElementById('quickCustomerError');
        var roleLabel = document.getElementById('quickCustomerRole');
        var parentId = {{ modalToClose|default('')|json_encode|raw }};
        var parentEl = parentId ? document.getElementById(parentId) : null;
        var parentModal = parentEl ? bootstrap.Modal.getOrCreateInstance(parentEl, {backdrop: 'static', keyboard: false}) : null;
        // Ruolo che ha aperto il modale: 'seller' o 'buyer'.
        var target = null;

        function backToParent() {
            modal.hide();
            if (parentModal) parentModal.show();
        }

        window.quickCustomerOpen = function (role) {
            target = role;
            form.reset();
            errorBox.classList.add('d-none');
            errorBox.textContent = '';
            roleLabel.textContent = role === 'seller' ? 'Venditore' : 'Acquirente';
            if (parentModal) parentModal.hide();
            modal.show();
        };

        window.quickCustomerCancel = backToParent;

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            errorBox.classList.add('d-none');

            fetch(form.action, {method: 'POST', body: new FormData(form), headers: {'Accept': 'application/json'}})
                .then(function (r) { return r.json(); })
                .then(function (data) {
                    if (!data.ok) {
                        errorBox.textContent = data.error || 'Creazione non riuscita.';
                        errorBox.classList.remove('d-none');
                        return;
                    }

                    // Il cliente appena creato prende il posto della ricerca: campo
                    // visibile con l'etichetta, hidden con l'id, come farebbe la tendina.
                    var key = '{{ prefix }}_' + target;
                    document.getElementById(key + 'Name').value = data.label;
                    document.getElementById(key).value = data.id;
                    var box = document.getElementById(key + 'Results');
                    if (box) box.style.display = 'none';
                    // I clienti ora ci sono: se l'invio era bloccato si sblocca.
                    document.querySelectorAll('[data-needs-customers]').forEach(function (btn) {
                        btn.disabled = false;
                    });
                    backToParent();
                })
                .catch(function () {
                    errorBox.textContent = 'Creazione non riuscita: riprova.';
                    errorBox.classList.remove('d-none');
                });
        });
    });
</script>
