{# 12.2 Campi della pratica, condivisi da inserimento e modifica.
   `practice` null = nuova pratica.
   `old` = dati di un invio rifiutato (vedi PracticeController::submittedPracticeInput):
   se c'è, i campi ripartono da lì invece che dall'entità. #}
{% set old = old|default({}) %}
{% set posted = old|length > 0 %}
{% set mortgageOn = posted ? old.mortgage : (practice and practice.mortgage) %}
<div class="row g-3">
    {# 12.2.1 / 12.2.2 Le parti si cercano nell'anagrafica clienti (11): i risultati
       compaiono sotto al campo, come nell'autocomplete studi dell'area admin. #}
    <div class="col-md-6 position-relative">
        <label class="form-label" for="{{ prefix }}_sellerName">Venditore *</label>
        <div class="input-group">
            <input type="text" id="{{ prefix }}_sellerName" class="form-control" autocomplete="off"
                   placeholder="Digita nome, cognome o codice fiscale…"
                   value="{{ posted ? old.seller_label : (practice and practice.seller ? practice.seller.fullName ~ (practice.seller.fiscalCode ? ' — ' ~ practice.seller.fiscalCode : '') : '') }}"
                   oninput="customerSearch('{{ prefix }}', 'seller')" onfocus="customerSearch('{{ prefix }}', 'seller', true)">
            {# Il cliente non c'è ancora in anagrafica: lo si crea da qui senza perdere la pratica. #}
            {% if quickCustomer %}
                <button type="button" class="btn btn-outline-secondary" onclick="quickCustomerOpen('seller')"
                        data-bs-toggle="tooltip" data-bs-title="Nuovo cliente">+</button>
            {% endif %}
        </div>
        <input type="hidden" id="{{ prefix }}_seller" name="seller_id" value="{{ posted ? old.seller_id : (practice and practice.seller ? practice.seller.id : '') }}">
        <ul id="{{ prefix }}_sellerResults" class="list-group position-absolute w-100 shadow-sm"
            style="z-index:1085; max-height:220px; overflow-y:auto; display:none;"></ul>
    </div>
    <div class="col-md-6 position-relative">
        <label class="form-label" for="{{ prefix }}_buyerName">Acquirente *</label>
        <div class="input-group">
            <input type="text" id="{{ prefix }}_buyerName" class="form-control" autocomplete="off"
                   placeholder="Digita nome, cognome o codice fiscale…"
                   value="{{ posted ? old.buyer_label : (practice and practice.buyer ? practice.buyer.fullName ~ (practice.buyer.fiscalCode ? ' — ' ~ practice.buyer.fiscalCode : '') : '') }}"
                   oninput="customerSearch('{{ prefix }}', 'buyer')" onfocus="customerSearch('{{ prefix }}', 'buyer', true)">
            {# Il cliente non c'è ancora in anagrafica: lo si crea da qui senza perdere la pratica. #}
            {% if quickCustomer %}
                <button type="button" class="btn btn-outline-secondary" onclick="quickCustomerOpen('buyer')"
                        data-bs-toggle="tooltip" data-bs-title="Nuovo cliente">+</button>
            {% endif %}
        </div>
        <input type="hidden" id="{{ prefix }}_buyer" name="buyer_id" value="{{ posted ? old.buyer_id : (practice and practice.buyer ? practice.buyer.id : '') }}">
        <ul id="{{ prefix }}_buyerResults" class="list-group position-absolute w-100 shadow-sm"
            style="z-index:1085; max-height:220px; overflow-y:auto; display:none;"></ul>
    </div>

    {# 12.2.3 Data di creazione #}
    <div class="col-md-3">
        <label class="form-label" for="{{ prefix }}_created_at">Data di creazione *</label>
        <input type="text" id="{{ prefix }}_created_at" name="created_at" class="form-control"
               placeholder="gg-mm-aaaa" autocomplete="off" required
               value="{{ posted ? old.created_at : (practice and practice.createdAt ? practice.createdAt|date('d-m-Y') : 'now'|date('d-m-Y')) }}">
    </div>

    {# 12.2.7 Contrassegno #}
    <div class="col-md-3">
        <label class="form-label" for="{{ prefix }}_mark">Contrassegno</label>
        <select id="{{ prefix }}_mark" name="mark_id" class="form-select">
            <option value="">Nessuno</option>
            {% for m in marks %}
                <option value="{{ m.id }}"{{ (posted ? old.mark_id == m.id : (practice and practice.mark and practice.mark.id == m.id)) ? ' selected' : '' }}>{{ m.value }}</option>
            {% endfor %}
        </select>
    </div>

    {# 12.2.4 Tipo di pratica: interruttore fra senza mutuo (spento) e con mutuo (acceso).
       Da checkbox: se resta spento non arriva nulla e il controller legge "senza mutuo". #}
    <div class="col-md-6">
        <label class="form-label d-block">
            Tipo di pratica *
            <img src="{{ asset(PATH_GRAPHICS ~ 'icons/info.png') }}" class="icon_info" alt="Informazioni"
                 data-bs-toggle="tooltip"
                 data-bs-title="Con mutuo entrano anche i documenti marcati «mutuo» nelle configurazioni.">
        </label>
        <div class="d-flex align-items-center gap-2">
            <span id="{{ prefix }}_mortgage_off" class="{{ mortgageOn ? 'op_07' : '' }}">Senza mutuo</span>
            <div class="form-check form-switch m-0">
                <input class="form-check-input" type="checkbox" role="switch"
                       id="{{ prefix }}_mortgage" name="mortgage" value="1"
                       {{ mortgageOn ? 'checked' : '' }}>
            </div>
            <label id="{{ prefix }}_mortgage_on" class="form-check-label m-0 {{ mortgageOn ? '' : 'op_07' }}" for="{{ prefix }}_mortgage">Con mutuo</label>
        </div>
    </div>

    {# 12.2.5 Indirizzo, con città e CAP dal catalogo geografico del master: tutti e tre
       sulla stessa riga (6 + 4 + 2). #}
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_address">Indirizzo dell'immobile *</label>
        <input type="text" id="{{ prefix }}_address" name="address" class="form-control" maxlength="255" required
               value="{{ posted ? old.address : (practice ? practice.address : '') }}" placeholder="Via e civico">
    </div>
    {% include 'components/geo/city_picker.html.twig' with {
        formName: prefix,
        number: geoNumber|default(1),
        required: true,
        cityCols: 4,
        zipCols: 2,
        cityId: posted ? old.city_id : (practice ? practice.cityRefId : ''),
        cityName: posted ? old.city_name : (practice ? practice.city : ''),
        zipId: posted ? old.zip_id : (practice ? practice.zipRefId : '')
    } only %}

    {# 12.2.9 Notaio assegnato: si cerca fra i notai in piattaforma (li crea
       l'amministrazione), come le parti ma senza inserimento. È questa scelta a dare
       al notaio l'accesso alla pratica, quindi il campo vuoto = nessun notaio. #}
    <div class="col-md-6 position-relative">
        <label class="form-label" for="{{ prefix }}_notaryName">Notaio</label>
        {% set notaryEmail = posted ? old.notary_email : (practice ? practice.notaryEmail : '') %}
        {% set notaryLabel = posted
            ? old.notary_label
            : (notaryEmail ? (notaries|filter(n => n.email == notaryEmail)|map(n => n.fullName ~ ' — ' ~ n.email)|first|default(notaryEmail)) : '') %}
        <input type="text" id="{{ prefix }}_notaryName" class="form-control" autocomplete="off"
               placeholder="Digita nome o e-mail del notaio…" value="{{ notaryLabel }}"
               oninput="notarySearch('{{ prefix }}')" onfocus="notarySearch('{{ prefix }}', true)">
        <input type="hidden" id="{{ prefix }}_notary" name="notary_email" value="{{ notaryEmail }}">
        <ul id="{{ prefix }}_notaryResults" class="list-group position-absolute w-100 shadow-sm"
            style="z-index:1085; max-height:220px; overflow-y:auto; display:none;"></ul>
        <div class="form-text">
            {% if notaries|length %}
                Lascia vuoto per non assegnare nessun notaio.
            {% else %}
                Nessun notaio disponibile: li inserisce l'amministrazione della piattaforma.
            {% endif %}
        </div>
    </div>

    <div class="col-12">
        <label class="form-label" for="{{ prefix }}_subject">Oggetto / note</label>
        <textarea id="{{ prefix }}_subject" name="subject" rows="4" class="form-control">{{ posted ? old.subject : (practice ? practice.subject : '') }}</textarea>
    </div>

    {# 12.2.6 Tag (più di uno) #}
    <div class="col-12">
        <label class="form-label d-block">Tag</label>
        {% if tags|length %}
            {% set selectedTags = posted ? old.tags : (practice ? practice.tags|map(t => t.id) : []) %}
            {% for t in tags %}
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="checkbox" name="tags[]" value="{{ t.id }}"
                           id="{{ prefix }}_tag_{{ t.id }}"{{ t.id in selectedTags ? ' checked' : '' }}>
                    <label class="form-check-label" for="{{ prefix }}_tag_{{ t.id }}">
                        <span class="badge" style="background:{{ t.color }}; color:{{ t.contrastColor }};">{{ t.value }}</span>
                    </label>
                </div>
            {% endfor %}
        {% else %}
            <small class="op_07">Nessun tag configurato. Puoi crearli nelle configurazioni.</small>
        {% endif %}
    </div>
</div>

{# Il datepicker va agganciato al DOMContentLoaded: nella pagina "nuova pratica" questi
   campi sono nel contenuto, quindi renderizzati PRIMA che jQuery e il plugin siano
   caricati (in fondo al body). Nei modali servirebbe subito, ma aspettare non guasta. #}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Interruttore mutuo: evidenzia la scritta corrispondente allo stato.
        var mortgage = document.getElementById('{{ prefix }}_mortgage');
        if (mortgage) {
            mortgage.addEventListener('change', function () {
                document.getElementById('{{ prefix }}_mortgage_off').classList.toggle('op_07', this.checked);
                document.getElementById('{{ prefix }}_mortgage_on').classList.toggle('op_07', !this.checked);
            });
        }

        var jq = window.jQuery;
        if (!jq || typeof jq.fn.datepicker !== 'function') {
            console.warn('Datepicker non disponibile per #{{ prefix }}_created_at');
            return;
        }
        var field = jq('#{{ prefix }}_created_at');
        var options = {format: 'dd-mm-yyyy', weekStart: 1, autoclose: true, todayHighlight: true};
        var modal = field.closest('.modal');
        if (modal.length) {
            options.container = '#' + modal.attr('id');
        }
        field.datepicker(options);
    });
</script>
