{# =====================================================================
   JS condiviso da contrassegni (13.2) e tag (13.3): apertura dei modali e
   anteprima live dell'etichetta.
   Variabili:
     prefix   : 'mark' | 'tag'
     basePath : URL dell'elenco, a cui si accoda "/{id}/modifica"
   ===================================================================== #}
<script>
    (function () {
        var BASE = "{{ basePath }}";

        /* Stessa soglia di luminanza del getContrastColor() lato PHP. */
        function contrastColor(hex) {
            var h = (hex || '').replace('#', '');
            if (h.length !== 6) return '#ffffff';
            var l = (0.299 * parseInt(h.substr(0, 2), 16)
                   + 0.587 * parseInt(h.substr(2, 2), 16)
                   + 0.114 * parseInt(h.substr(4, 2), 16)) / 255;
            return l > 0.6 ? '#10201c' : '#ffffff';
        }

        /* Richiamata dagli oninput dei campi (vedi _color_value_fields). */
        window.colorPreview = function (formPrefix) {
            var value = document.getElementById(formPrefix + '_value').value;
            var color = document.getElementById(formPrefix + '_color').value;
            var preview = document.getElementById(formPrefix + '_preview');
            preview.textContent = value || preview.dataset.placeholder || '—';
            preview.style.background = color;
            preview.style.color = contrastColor(color);
        };

        window["{{ prefix }}NewOpen"] = function () {
            document.getElementById("{{ prefix }}NewForm").reset();
            colorPreview("{{ prefix }}New");
            window["{{ prefix }}NewShow"]();
        };

        window["{{ prefix }}EditOpen"] = function (el) {
            document.getElementById("{{ prefix }}EditForm").action = BASE + '/' + el.dataset.id + '/modifica';
            document.getElementById("{{ prefix }}Edit_value").value = el.dataset.value || '';
            document.getElementById("{{ prefix }}Edit_color").value = el.dataset.color || '#1D4ED8';
            colorPreview("{{ prefix }}Edit");
            window["{{ prefix }}EditShow"]();
        };
    })();
</script>
