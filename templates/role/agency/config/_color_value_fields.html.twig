{# 13.2.2 / 13.3.2 Campi di contrassegni e tag: colore + valore, con anteprima dell'etichetta. #}
<div class="row g-3">
    <div class="col-md-8">
        <label class="form-label" for="{{ prefix }}_value">Valore *</label>
        <input type="text" id="{{ prefix }}_value" name="value" class="form-control" maxlength="190" required
               placeholder="{{ placeholder|default('Es. Urgente') }}" oninput="colorPreview('{{ prefix }}')">
    </div>
    <div class="col-md-4">
        <label class="form-label" for="{{ prefix }}_color">Colore *</label>
        <input type="color" id="{{ prefix }}_color" name="color" class="form-control form-control-color w-100"
               value="#1D4ED8" required oninput="colorPreview('{{ prefix }}')">
    </div>
    <div class="col-12">
        <span class="op_07 font_13">Anteprima:</span>
        <span id="{{ prefix }}_preview" class="badge ms-1" style="background:#1D4ED8; color:#ffffff;">
            {{ placeholder|default('Es. Urgente') }}
        </span>
    </div>
</div>
