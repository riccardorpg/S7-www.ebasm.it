{% extends 'role/agency/layout.html.twig' %}

{% block title %} - Contrassegni pratiche{% endblock %}
{% block role_page_title_inner %}Contrassegni pratiche{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('agency_index') }}">Agenzia</a></li>
    <li class="breadcrumb-item">Configurazioni</li>
    <li class="breadcrumb-item active" aria-current="page">Contrassegni pratiche</li>
{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('agency_index') }}">Torna alla scrivania</a></li>
{% endblock %}

{% block sub_menu_right %}
    <li class="nav-item"><a class="nav-link" href="javascript:markNewOpen()">Nuovo</a></li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            {% include 'role/agency/config/_color_value_list.html.twig' with {
                prefix: 'mark',
                alias: 'm',
                records: records,
                filter: filter,
                label: 'contrassegno',
                indexRoute: 'agency_practice_marks',
                deleteRoute: 'agency_practice_mark_delete'
            } only %}
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% embed 'components/modals/form_modal.html.twig' with {type: 'markNew', title: 'Nuovo contrassegno', action: path('agency_practice_mark_new')} %}
        {% block modalBody %}{{ include('role/agency/config/_color_value_fields.html.twig', {prefix: 'markNew', placeholder: 'Es. Urgente'}) }}{% endblock %}
        {% block modalSubmit %}Crea{% endblock %}
    {% endembed %}

    {% embed 'components/modals/form_modal.html.twig' with {type: 'markEdit', title: 'Modifica contrassegno'} %}
        {% block modalBody %}{{ include('role/agency/config/_color_value_fields.html.twig', {prefix: 'markEdit', placeholder: 'Es. Urgente'}) }}{% endblock %}
    {% endembed %}

    {% include 'components/modals/delete_modal.html.twig' with {type: 'mark', title: 'Contrassegno', text: 'eliminerai il contrassegno selezionato'} only %}
{% endblock %}

{% block page_javascripts %}
    {% include 'role/agency/config/_color_value_js.html.twig' with {prefix: 'mark', basePath: path('agency_practice_marks')} only %}
    {% include 'components/table/sort_js.html.twig' with {
        formName: 'markFilter', sortId: 'markFilter_sort', directionId: 'markFilter_direction',
        actualSort: app.request.query.get('sort'), actualDirection: app.request.query.get('direction')
    } only %}
{% endblock %}
