{% extends 'role/agency/layout.html.twig' %}

{% block title %} - Tag pratiche{% endblock %}
{% block role_page_title_inner %}Tag pratiche{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('agency_index') }}">Agenzia</a></li>
    <li class="breadcrumb-item">Configurazioni</li>
    <li class="breadcrumb-item active" aria-current="page">Tag pratiche</li>
{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('agency_index') }}">Torna alla scrivania</a></li>
{% endblock %}

{% block sub_menu_right %}
    <li class="nav-item"><a class="nav-link" href="javascript:tagNewOpen()">Nuovo</a></li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">
            {% include 'role/agency/config/_color_value_list.html.twig' with {
                prefix: 'tag',
                alias: 't',
                records: records,
                filter: filter,
                label: 'tag',
                indexRoute: 'agency_practice_tags',
                deleteRoute: 'agency_practice_tag_delete'
            } only %}
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% embed 'components/modals/form_modal.html.twig' with {type: 'tagNew', title: 'Nuovo tag', action: path('agency_practice_tag_new')} %}
        {% block modalBody %}{{ include('role/agency/config/_color_value_fields.html.twig', {prefix: 'tagNew', placeholder: 'Es. Prima casa'}) }}{% endblock %}
        {% block modalSubmit %}Crea{% endblock %}
    {% endembed %}

    {% embed 'components/modals/form_modal.html.twig' with {type: 'tagEdit', title: 'Modifica tag'} %}
        {% block modalBody %}{{ include('role/agency/config/_color_value_fields.html.twig', {prefix: 'tagEdit', placeholder: 'Es. Prima casa'}) }}{% endblock %}
    {% endembed %}

    {% include 'components/modals/delete_modal.html.twig' with {type: 'tag', title: 'Tag', text: 'eliminerai il tag selezionato'} only %}
{% endblock %}

{% block page_javascripts %}
    {% include 'role/agency/config/_color_value_js.html.twig' with {prefix: 'tag', basePath: path('agency_practice_tags')} only %}
    {% include 'components/table/sort_js.html.twig' with {
        formName: 'tagFilter', sortId: 'tagFilter_sort', directionId: 'tagFilter_direction',
        actualSort: app.request.query.get('sort'), actualDirection: app.request.query.get('direction')
    } only %}
{% endblock %}
