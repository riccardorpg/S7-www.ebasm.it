{# 13.1 Campi del tipo di documento.
   Fuori dal form: la priorità (si imposta trascinando la riga) e lo stato
   (si cambia con l'icona attiva/disattiva nell'elenco). #}
<div class="row g-3">
    <div class="col-12">
        <label class="form-label" for="{{ prefix }}_value">Valore *</label>
        <input type="text" id="{{ prefix }}_value" name="value" class="form-control" maxlength="190" required
               placeholder="Es. Visura catastale">
    </div>
    <div class="col-12">
        <div class="form-check form-switch">
            <input class="form-check-input" type="checkbox" role="switch" id="{{ prefix }}_mortgage" name="mortgage" value="1">
            <label class="form-check-label" for="{{ prefix }}_mortgage">Mutuo</label>
        </div>
        <small class="op_07">Richiesto solo nelle pratiche con mutuo.</small>
    </div>
</div>
