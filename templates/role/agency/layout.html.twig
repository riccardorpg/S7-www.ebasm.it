{% extends 'role/base.html.twig' %}

{% block home_path %}{{ path('agency_index') }}{% endblock %}

{% block role_menu %}
    {% set r = app.request.attributes.get('_route') %}
    <li class="menu-item{{ r == 'agency_index' ? ' current' : '' }}">
        <a class="menu-link" href="{{ path('agency_index') }}"><div>Scrivania</div></a>
    </li>
    {# 10.1.5 Le voci compaiono solo a chi ha almeno la lettura sulla sezione. #}
    {% if is_granted('view', 'practices') %}
        {# "agency_practice_mark"/"agency_practice_tag" sono le configurazioni, non le pratiche. #}
        {% set onPractices = r starts with 'agency_practice' and not (r starts with 'agency_practice_mark') and not (r starts with 'agency_practice_tag') %}
        <li class="menu-item{{ onPractices ? ' current' : '' }}">
            <a class="menu-link" href="{{ path('agency_practices') }}"><div>Pratiche</div></a>
        </li>
    {% endif %}
    {% if is_granted('view', 'staff') %}
        <li class="menu-item{{ r starts with 'agency_staff' ? ' current' : '' }}">
            <a class="menu-link" href="{{ path('agency_staff') }}"><div>Staff</div></a>
        </li>
    {% endif %}
    {% if is_granted('view', 'customers') %}
        <li class="menu-item{{ r starts with 'agency_customer' ? ' current' : '' }}">
            <a class="menu-link" href="{{ path('agency_customers') }}"><div>Clienti</div></a>
        </li>
    {% endif %}
    {# 13. Configurazioni: una voce di sottomenu per pagina. #}
    {% if is_granted('view', 'configurations') %}
        <li class="menu-item{{ r starts with 'agency_document_type' or r starts with 'agency_practice_' ? ' current' : '' }}">
            <a class="menu-link" href="{{ path('agency_document_types') }}"><div>Configurazioni</div></a>
            <ul class="sub-menu-container">
                <li class="menu-item{{ r starts with 'agency_document_type' ? ' current' : '' }}">
                    <a class="menu-link" href="{{ path('agency_document_types') }}">Tipi di documento</a>
                </li>
                <li class="menu-item{{ r starts with 'agency_practice_mark' ? ' current' : '' }}">
                    <a class="menu-link" href="{{ path('agency_practice_marks') }}">Contrassegni pratiche</a>
                </li>
                <li class="menu-item{{ r starts with 'agency_practice_tag' ? ' current' : '' }}">
                    <a class="menu-link" href="{{ path('agency_practice_tags') }}">Tag pratiche</a>
                </li>
            </ul>
        </li>
    {% endif %}
    <li class="menu-item">
        <a class="menu-link" href="{{ path('logout') }}"><div>Esci</div></a>
    </li>
{% endblock %}

{% block role_page_title_breadcrumb %}
    {% set crumb_current = block('role_page_title_inner')|striptags|trim %}
    <li class="breadcrumb-item">
        {% if app.request.attributes.get('_route') == 'agency_index' %}
            Agenzia
        {% else %}
            <a href="{{ path('agency_index') }}">Agenzia</a>
        {% endif %}
    </li>
    {% if app.request.attributes.get('_route') != 'agency_index' and crumb_current %}
        <li class="breadcrumb-item active" aria-current="page">{{ crumb_current }}</li>
    {% endif %}
{% endblock %}
