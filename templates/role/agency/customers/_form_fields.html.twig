{# 11.2.1 / 11.2.2 Campi del cliente: anagrafici e fiscali. #}
<h6 class="m_b_10p">Dati anagrafici</h6>
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_name">Nome</label>
        <input type="text" id="{{ prefix }}_name" name="name" class="form-control" maxlength="190">
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_surname">Cognome / Ragione sociale *</label>
        <input type="text" id="{{ prefix }}_surname" name="surname" class="form-control" maxlength="190" required>
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_birth_place">Luogo di nascita</label>
        <input type="text" id="{{ prefix }}_birth_place" name="birth_place" class="form-control" maxlength="190">
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_birth_date">Data di nascita</label>
        <input type="text" id="{{ prefix }}_birth_date" name="birth_date" class="form-control"
               placeholder="gg-mm-aaaa" autocomplete="off">
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_address">Indirizzo</label>
        <input type="text" id="{{ prefix }}_address" name="address" class="form-control" maxlength="255">
    </div>
    <div class="col-md-4">
        <label class="form-label" for="{{ prefix }}_city">Città</label>
        <input type="text" id="{{ prefix }}_city" name="city" class="form-control" maxlength="190">
    </div>
    <div class="col-md-2">
        <label class="form-label" for="{{ prefix }}_zip">CAP</label>
        <input type="text" id="{{ prefix }}_zip" name="zip" class="form-control" maxlength="10">
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_email">E-mail</label>
        <input type="email" id="{{ prefix }}_email" name="email" class="form-control" maxlength="190">
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_phone">Telefono</label>
        <input type="text" id="{{ prefix }}_phone" name="phone" class="form-control" maxlength="40">
    </div>
</div>

<h6 class="p_t_15p m_b_10p">Dati fiscali</h6>
<div class="row g-3">
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_fiscal_code">Codice fiscale</label>
        <input type="text" id="{{ prefix }}_fiscal_code" name="fiscal_code" class="form-control text-uppercase" maxlength="32">
    </div>
    <div class="col-md-6">
        <label class="form-label" for="{{ prefix }}_vat_number">Partita IVA</label>
        <input type="text" id="{{ prefix }}_vat_number" name="vat_number" class="form-control" maxlength="20">
    </div>
    <div class="col-md-8">
        <label class="form-label" for="{{ prefix }}_pec">PEC</label>
        <input type="email" id="{{ prefix }}_pec" name="pec" class="form-control" maxlength="190">
    </div>
    <div class="col-md-4">
        <label class="form-label" for="{{ prefix }}_sdi">Codice SDI</label>
        <input type="text" id="{{ prefix }}_sdi" name="sdi" class="form-control text-uppercase" maxlength="7">
    </div>
    <div class="col-12">
        <label class="form-label" for="{{ prefix }}_notes">Note</label>
        <textarea id="{{ prefix }}_notes" name="notes" rows="2" class="form-control"></textarea>
    </div>
</div>

{# Datepicker (bootstrap-datepicker, già caricato da role/base) sulla data di nascita.
   Lo script sta qui perché i modali sono renderizzati in #divModals, dopo i javascripts.

   `container`: senza, il calendario viene appeso al <body> e finisce sotto al modale
   (che sta a z-index 1055, mentre datepicker.css non dichiara alcun z-index). Appendendolo
   dentro al modale entra nello stesso contesto di impilamento ed è visibile e cliccabile.
   Canvas fa `jQuery.noConflict()` in functions.js, quindi usiamo window.jQuery. #}
<script>
    (function () {
        var jq = window.jQuery;
        if (!jq || typeof jq.fn.datepicker !== 'function') {
            console.warn('Datepicker non disponibile per #{{ prefix }}_birth_date');
            return;
        }
        jq('#{{ prefix }}_birth_date').datepicker({
            format: 'dd-mm-yyyy',
            weekStart: 1,
            autoclose: true,
            todayHighlight: true,
            endDate: '0d',
            container: '#{{ prefix }}Modal'
        });
    })();
</script>
