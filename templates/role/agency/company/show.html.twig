{% extends 'role/agency/layout.html.twig' %}

{# 7.1.9 Anagrafica della propria agenzia: i dati stanno su Company (DB master).
   Codice cliente, licenza, quota e stato li gestisce l'amministrazione: qui si leggono. #}
{% set canEdit = is_granted('edit', 'company') %}

{% block title %} - Anagrafica agenzia{% endblock %}
{% block role_page_title_inner %}Anagrafica agenzia{% endblock %}

{% block role_page_title_breadcrumb %}
    <li class="breadcrumb-item"><a href="{{ path('agency_index') }}">Agenzia</a></li>
    <li class="breadcrumb-item active" aria-current="page">Anagrafica</li>
{% endblock %}

{% block sub_menu_left %}
    <li class="nav-item"><a class="nav-link" href="{{ path('agency_index') }}">Torna alla scrivania</a></li>
{% endblock %}

{% block role_content %}
    <section class="content-wrap">
        <div class="container">

            {# ===== 7.1.9.8 Logo ===== #}
            <div class="d-flex justify-content-between align-items-center m_b_10p">
                <h6 class="m-0">Logo</h6>
                {% if canEdit %}
                    <a href="javascript:companyLogoShow()" class="button button-3d button-mini button-amber m-0">Modifica</a>
                {% endif %}
            </div>
            <div class="d-flex align-items-center gap-3 m_b_30p">
                {% if company.logo %}
                    <img src="{{ path('agency_company_logo') }}" alt="Logo {{ company.name }}"
                         style="max-height:90px; max-width:260px;">
                    {% if canEdit %}
                        <form method="post" action="{{ path('agency_company_logo_delete') }}" class="m-0"
                              onsubmit="return confirm('Rimuovere il logo?');">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('delete') }}">
                            <button type="submit" class="button button-3d button-mini button-red m-0">Rimuovi</button>
                        </form>
                    {% endif %}
                {% else %}
                    <span class="op_07">Nessun logo caricato.</span>
                {% endif %}
            </div>

            {# ===== 7.1.9.1 Dati anagrafici ===== #}
            <div class="d-flex justify-content-between align-items-center m_b_10p">
                <h6 class="m-0">Dati anagrafici</h6>
                {% if canEdit %}
                    <a href="javascript:companyProfileOpen()" class="button button-3d button-mini button-amber m-0">Modifica</a>
                {% endif %}
            </div>
            <table class="table align-middle m_b_30p">
                <tr><th style="width:25%">Ragione sociale / Nome</th><td>{{ company.name }}</td></tr>
                <tr><th>Tipo</th><td>{{ company.clientTypeLabel }}</td></tr>
                <tr>
                    <th>Indirizzo</th>
                    <td>{{ company.address ? company.address ~ (company.civic ? ', ' ~ company.civic : '') : '—' }}</td>
                </tr>
                <tr>
                    <th>Città</th>
                    <td>
                        {# City ha __toString: "Comune (SIGLA)", come nella scheda cliente dell'admin. #}
                        {% if company.city %}
                            {{ company.zip ? company.zip.code ~ ' ' : '' }}{{ company.city }}
                        {% else %}—{% endif %}
                    </td>
                </tr>
            </table>

            {# ===== 7.1.9.1 Dati fiscali ===== #}
            <div class="d-flex justify-content-between align-items-center m_b_10p">
                <h6 class="m-0">Dati fiscali</h6>
                {% if canEdit %}
                    <a href="javascript:companyTaxOpen()" class="button button-3d button-mini button-amber m-0">Modifica</a>
                {% endif %}
            </div>
            <table class="table align-middle m_b_30p">
                <tr><th style="width:25%">Partita IVA</th><td>{{ company.vatNumber ?: '—' }}</td></tr>
                <tr><th>Codice fiscale</th><td>{{ company.taxCode ?: '—' }}</td></tr>
                <tr><th>Codice SDI</th><td>{{ company.sdi ?: '—' }}</td></tr>
                <tr><th>PEC</th><td>{{ company.pec ?: '—' }}</td></tr>
            </table>

            {# ===== Dati di servizio: li gestisce l'amministrazione della piattaforma ===== #}
            <h6 class="m_b_10p">Abbonamento</h6>
            <table class="table align-middle m_b_none">
                <tr><th style="width:25%">Codice cliente</th><td><span class="badge bg-secondary">{{ company.code }}</span></td></tr>
                <tr><th>Licenza</th><td>{{ company.licenseTypeLabel }}</td></tr>
                <tr>
                    <th>Scadenza</th>
                    <td>{{ company.licenseExpiresAt ? company.licenseExpiresAt|date('d/m/Y') : '—' }}</td>
                </tr>
                <tr>
                    <th>Spazio</th>
                    <td>
                        {{ storageUsedMb|number_format(1, ',', '.') }} MB
                        <span class="op_07 font_13">su {{ company.storageQuotaMb|number_format(0, ',', '.') }} MB</span>
                    </td>
                </tr>
            </table>
            <small class="op_07">
                Codice cliente, licenza e spazio sono gestiti dall'amministrazione della piattaforma.
            </small>
        </div>
    </section>
{% endblock %}

{% block modals %}
    {% if canEdit %}
        {# 7.1.9.1 Dati anagrafici #}
        {% embed 'components/modals/form_modal.html.twig' with {
            type: 'companyProfile', title: 'Dati anagrafici', action: path('agency_company_profile'), size: 'modal-lg'
        } %}
            {% block modalBody %}
                <div class="row g-3">
                    <div class="col-md-8">
                        <label class="form-label" for="companyProfile_name">Ragione sociale / Nome *</label>
                        <input type="text" id="companyProfile_name" name="name" class="form-control" maxlength="191" required>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="companyProfile_client_type">Tipo</label>
                        <select id="companyProfile_client_type" name="client_type" class="form-select">
                            <option value="company">Azienda</option>
                            <option value="professional">Privato</option>
                        </select>
                    </div>
                    <div class="col-md-9">
                        <label class="form-label" for="companyProfile_address">Indirizzo</label>
                        <input type="text" id="companyProfile_address" name="address" class="form-control" maxlength="191">
                    </div>
                    <div class="col-md-3">
                        <label class="form-label" for="companyProfile_civic">Civico</label>
                        <input type="text" id="companyProfile_civic" name="civic" class="form-control" maxlength="16">
                    </div>
                    {% include 'components/geo/city_picker.html.twig' with {
                        formName: 'companyProfile',
                        number: 1,
                        cityCols: 8,
                        zipCols: 4,
                        cityId: company.city ? company.city.id : '',
                        cityName: company.city ? company.city.name : '',
                        zipId: company.zip ? company.zip.id : ''
                    } only %}
                </div>
            {% endblock %}
        {% endembed %}

        {# Ricerca comune per il picker Città/CAP dentro il modale anagrafico #}
        {% include 'components/modals/city.html.twig' with {number: 1, cities: []} only %}

        {# 7.1.9.1 Dati fiscali #}
        {% embed 'components/modals/form_modal.html.twig' with {
            type: 'companyTax', title: 'Dati fiscali', action: path('agency_company_tax')
        } %}
            {% block modalBody %}
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label" for="companyTax_vat_number">Partita IVA</label>
                        <input type="text" id="companyTax_vat_number" name="vat_number" class="form-control" maxlength="16">
                    </div>
                    <div class="col-md-6">
                        <label class="form-label" for="companyTax_tax_code">Codice fiscale</label>
                        <input type="text" id="companyTax_tax_code" name="tax_code" class="form-control text-uppercase" maxlength="32">
                    </div>
                    <div class="col-md-4">
                        <label class="form-label" for="companyTax_sdi">Codice SDI</label>
                        <input type="text" id="companyTax_sdi" name="sdi" class="form-control text-uppercase" maxlength="7">
                    </div>
                    <div class="col-md-8">
                        <label class="form-label" for="companyTax_pec">PEC</label>
                        <input type="email" id="companyTax_pec" name="pec" class="form-control" maxlength="191">
                    </div>
                </div>
            {% endblock %}
        {% endembed %}

        {# 7.1.9.8 Logo #}
        {% embed 'components/modals/form_modal.html.twig' with {
            type: 'companyLogo', title: 'Logo dell\'agenzia', action: path('agency_company_logo_upload'), enctype: 'multipart/form-data'
        } %}
            {% block modalBody %}
                <label class="form-label" for="companyLogo_file">Immagine *</label>
                <input type="file" id="companyLogo_file" name="logo" class="form-control"
                       accept="image/jpeg,image/png,image/webp" required>
                <div class="form-text">JPG, PNG o WEBP, fino a 2 MB. Sostituisce il logo attuale.</div>
            {% endblock %}
            {% block modalSubmit %}Carica{% endblock %}
        {% endembed %}
    {% endif %}
{% endblock %}

{% block page_javascripts %}
    {% if canEdit %}
        {# Il picker città sta dentro il modale anagrafico: al ritorno lo si riapre. #}
        {% include 'components/js/city_js.html.twig' with {
            number: 1, formName: 'companyProfile', modalToClose: 'companyProfileModal'
        } only %}
        <script>
            /* I modali partono sempre dai dati salvati, anche dopo un "Annulla". */
            function companyProfileOpen() {
                document.getElementById('companyProfile_name').value = {{ company.name|json_encode|raw }};
                document.getElementById('companyProfile_client_type').value = {{ company.clientType|json_encode|raw }};
                document.getElementById('companyProfile_address').value = {{ (company.address ?? '')|json_encode|raw }};
                document.getElementById('companyProfile_civic').value = {{ (company.civic ?? '')|json_encode|raw }};
                companyProfileShow();
            }

            function companyTaxOpen() {
                document.getElementById('companyTax_vat_number').value = {{ (company.vatNumber ?? '')|json_encode|raw }};
                document.getElementById('companyTax_tax_code').value = {{ (company.taxCode ?? '')|json_encode|raw }};
                document.getElementById('companyTax_sdi').value = {{ (company.sdi ?? '')|json_encode|raw }};
                document.getElementById('companyTax_pec').value = {{ (company.pec ?? '')|json_encode|raw }};
                companyTaxShow();
            }
        </script>
    {% endif %}
{% endblock %}
