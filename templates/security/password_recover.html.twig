{% extends 'public/layout.html.twig' %}

{% block title %} - Recupera password{% endblock %}
{% block robots %}<meta name="robots" content="noindex, follow">{% endblock %}

{% block content %}
    <section class="eb-section" style="padding-top:150px; min-height:70vh;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-md-7 col-lg-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-body p-4">
                            <h3 class="mb-1">Recupera password</h3>
                            <p class="text-muted mb-4">Inserisci la tua e-mail: ti invieremo un link per creare una nuova password.</p>

                            <form method="post" action="{{ path('password_recover') }}">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('recover') }}">
                                {% if code %}<input type="hidden" name="code" value="{{ code }}">{% endif %}
                                <div class="form-group mb-3">
                                    <label class="form-label">E-mail</label>
                                    <input type="email" name="email" class="form-control" autofocus required>
                                </div>
                                <button type="submit" class="button button-3d button-rounded button-large m-0 w-100" style="background:var(--eb-brand);">Invia link di recupero</button>
                            </form>
                        </div>
                    </div>
                    <p class="text-center mt-3">
                        <a href="{{ code ? path('login_dedicated', {'code': code}) : path('login') }}" class="font_13 text-muted">&larr; Torna all'accesso</a>
                    </p>
                </div>
            </div>
        </div>
    </section>
{% endblock %}
