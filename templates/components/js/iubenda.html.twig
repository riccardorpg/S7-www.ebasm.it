{# ===========================================================================
   IUBENDA — parte da caricare in fondo al <body> (blocco javascripts).
   La configurazione e l'autoblocking stanno in iubenda_head.html.twig.

   iubenda.js  : trasforma i link .iubenda-embed del footer (Privacy/Cookie
                 Policy) nei badge e li apre in modale. Il loader si aggancia a
                 window.load, quindi non blocca il rendering.
   iubenda_cs.js : banner di consenso.
   =========================================================================== #}
<script type="text/javascript">
    (function (w, d) {
        var loader = function () {
            var s = d.createElement("script"), tag = d.getElementsByTagName("script")[0];
            s.src = "https://cdn.iubenda.com/iubenda.js";
            tag.parentNode.insertBefore(s, tag);
        };
        if (w.addEventListener) { w.addEventListener("load", loader, false); }
        else if (w.attachEvent) { w.attachEvent("onload", loader); }
        else { w.onload = loader; }
    })(window, document);
</script>
<script type="text/javascript" src="//cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async></script>
