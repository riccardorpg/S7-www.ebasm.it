{# ===========================================================================
   SET DI ICONE SVG INLINE — sostituisce le Bootstrap Icons nella parte pubblica.

   Uso:  {% import 'components/icons.html.twig' as ico %}
         {{ ico.svg('cloud') }}
         {{ ico.svg('check-circle', 'me-2', 'color:#fff') }}

   Ogni icona è disegnata su viewBox 24x24 con tratto (stroke) e nessun fill:
   gli stili vivono in public/css/hr.css (.eb-ico → width/height 1em,
   stroke: currentColor), quindi le icone ereditano font-size e color del
   contenitore esattamente come facevano i tag <i>.
   Ogni SVG riceve anche la classe modificatore .eb-ico--<nome>
   (usata p.es. da .eb-ico--semaforo per il tratto più sottile).
   =========================================================================== #}

{% macro svg(name, class = '', style = '') %}
    {%- set icons = {
        'play-circle':     '<circle cx="12" cy="12" r="9.5"/><path d="m10 8.5 6 3.5-6 3.5z"/>',
        'chat':            '<path d="M21 11.5a8.5 8.5 0 0 1-8.5 8.5 8.4 8.4 0 0 1-3.8-.9L3.5 21l1.4-4.2a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 8.5-8.5h.5a8.5 8.5 0 0 1 8 8z"/>',
        'cloud':           '<path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9z"/>',
        'shield':          '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
        'boxes':           '<path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.3 7 8.7 5 8.7-5"/><path d="M12 22V12"/>',
        'globe':           '<circle cx="12" cy="12" r="9.5"/><path d="M2.5 12h19"/><path d="M12 2.5a15 15 0 0 1 4 9.5 15 15 0 0 1-4 9.5 15 15 0 0 1-4-9.5 15 15 0 0 1 4-9.5z"/>',
        'target':          '<circle cx="12" cy="12" r="9.5"/><circle cx="12" cy="12" r="5.5"/><circle cx="12" cy="12" r="1.5"/>',
        'eye':             '<path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>',
        'check-circle':    '<circle cx="12" cy="12" r="9.5"/><path d="m8 12.5 2.5 2.5L16 9.5"/>',
        'check':           '<path d="M20 6 9 17l-5-5"/>',
        'people':          '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>',
        'folder-check':    '<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7L11 4H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2z"/><path d="m9.5 13 2 2 3.5-3.5"/>',
        'search':          '<circle cx="11" cy="11" r="7.5"/><path d="m21 21-4.3-4.3"/>',
        'hdd':             '<path d="M22 12H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/><path d="M6 16h.01"/><path d="M10 16h.01"/>',
        'credit-card':     '<rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/>',
        'envelope':        '<rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-10 6L2 7"/>',
        'arrow-up-right':  '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
        'rocket':          '<path d="M4.5 16.5c-1.5 1.26-2 5-2 5s3.74-.5 5-2c.79-.78.8-2.07.09-2.91a2.18 2.18 0 0 0-3.09-.09z"/><path d="m12 15-3-3a22 22 0 0 1 2-3.95A12.9 12.9 0 0 1 22 2c0 2.72-.78 7.5-6 11a22.4 22.4 0 0 1-4 2z"/><path d="M9 12H4s.55-3.03 2-4c1.62-1.08 5 0 5 0"/><path d="M12 15v5s3.03-.55 4-2c1.08-1.62 0-5 0-5"/>',
        'x':               '<path d="M18 6 6 18"/><path d="m6 6 12 12"/>',
        'semaforo':        '<rect x="7.5" y="2" width="9" height="20" rx="3"/><path d="M4.5 7h3M4.5 12h3M4.5 17h3" stroke-opacity=".45"/><circle cx="12" cy="7" r="1.9" fill="#EF4444" stroke="none"/><circle cx="12" cy="12" r="1.9" fill="#F59E0B" stroke="none"/><circle cx="12" cy="17" r="1.9" fill="#22C55E" stroke="none"/>'
    } -%}
    <svg class="eb-ico eb-ico--{{ name }}{{ class ? ' ' ~ class }}"{% if style %} style="{{ style }}"{% endif %} viewBox="0 0 24 24" role="img" aria-hidden="true" focusable="false">{{ icons[name]|default('<circle cx="12" cy="12" r="9.5"/>')|raw }}</svg>
{% endmacro %}
