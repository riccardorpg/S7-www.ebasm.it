{# ===========================================================================
   Modale "Recupera password", condivisa dalle pagine di accesso.
   Posta su password_recover, che valida il token 'recover' e redirige a login
   con un messaggio generico (nessuna user enumeration).

   Parametro opzionale `codice`: sulla pagina dedicata dell'agenzia va passato,
   così il controller cerca l'utente anche nel DB del tenant e non solo sul master.
   Includere con with_context = false per evitare che un `codice` presente nel
   contesto della pagina finisca qui per errore.
   =========================================================================== #}
{% set codice = codice|default('') %}
<div class="modal fade" id="modalRecover" tabindex="-1" aria-labelledby="modalRecoverLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0">
            <div class="modal-header border-0">
                <h5 class="modal-title" id="modalRecoverLabel">Recupera password</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <form method="post" action="{{ path('password_recover') }}">
                <div class="modal-body pt-0">
                    <p class="text-muted font_13">
                        Inserisci la tua e-mail: ti invieremo un link per impostare una nuova password.
                    </p>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('recover') }}">
                    {# name="code": è il campo che legge password_recover. #}
                    {% if codice %}<input type="hidden" name="code" value="{{ codice }}">{% endif %}
                    <div class="form-group mb-0">
                        <label class="form-label" for="recoverEmail">E-mail</label>
                        <input type="email" id="recoverEmail" name="email" class="form-control"
                               placeholder="nome@esempio.it" autocomplete="email" required>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button type="submit" class="button button-3d button-rounded m-0 w-100" style="background:var(--eb-brand);">
                        Invia link <i class="bi-send"></i>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
