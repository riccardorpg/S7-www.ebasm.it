<!DOCTYPE html>
<html lang="it" data-theme="{{ app.user is not null and app.user.theme is defined ? app.user.theme : 'light' }}">
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="content-language" content="it">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">

        {# Anti-flicker: per 'auto' risolve subito chiaro/scuro dal sistema prima del rendering #}
        <script>
            (function () {
                var html = document.documentElement;
                var theme = html.getAttribute('data-theme') || 'light';
                if (theme === 'auto') {
                    var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
                    html.setAttribute('data-theme-resolved', prefersDark ? 'dark' : 'light');
                } else {
                    html.setAttribute('data-theme-resolved', theme);
                }
            })();
        </script>

        <meta name="author" content="R.P.G. Servizi Multimediali">
        <meta name="copyright" content="EBASM">
        <meta name="theme" content="Canvas - ThemeForest">
        <meta name="symfony-version" content="7.4">

        {% block robots %}<meta name="robots" content="noindex, nofollow">{% endblock %}

        <meta name="description" content="{% block description %}EBASM{% endblock %}">

        <title>EBASM{% block title %}{% endblock %}</title>

        {# CANVAS - tema ThemeForest #}
        {% block stylesheets %}
            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=IBM+Plex+Mono:wght@400;500;600&family=PT+Serif:ital@0;1&display=swap">

            <link rel="stylesheet" href="{{ asset('css/style.css') }}">
            <link rel="stylesheet" href="{{ asset('css/font-icons.css') }}">
            <link rel="stylesheet" href="{{ asset('css/swiper.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/bs-switches.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/radio-checkbox.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/datepicker.css') }}">
            <link rel="stylesheet" href="{{ asset('css/components/daterangepicker.css') }}">

            {% block page_stylesheets %}{% endblock %}

            <link rel="stylesheet" href="{{ asset('css/personal/classes.css') }}">
            <link rel="stylesheet" href="{{ asset('css/personal/custom.css') }}">
            <link rel="stylesheet" href="{{ asset('css/personal/themeOverride.css') }}">
        {% endblock %}

        {% block meta %}{% endblock %}
        {% block recaptcha %}{% endblock %}

        <link rel="shortcut icon" href="{{ asset('favicon.ico') }}">
    </head>
    <body id="body" class="stretched {% block body_class %}side-header open-header close-header-on-scroll{% endblock %}">

        {% if is_granted('IS_IMPERSONATOR') %}
            <div class="alert alert-warning alert-dismissible txt_a_c m_b_none" style="border-radius:0;position:relative;z-index:1000;">
                <i class="fa-solid fa-user-secret"></i>
                Stai impersonando <strong>{{ app.user.userIdentifier }}</strong> —
                <a href="{{ path('agency_index', {'_switch_user': '_exit'}) }}">Torna ad amministratore</a>
            </div>
        {% endif %}

        <div id="noticesContainer" class="notices">
            {% for flash_message in app.flashes('success') %}
                <div class="alert alert-dismissible alert-success notice">
                    <i class="fa-solid fa-thumbs-up"></i> <strong>Complimenti!</strong> {{ flash_message|raw }}
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            {% for flash_message in app.flashes('warning') %}
                <div class="alert alert-dismissible alert-warning notice">
                    <i class="fa-solid fa-triangle-exclamation"></i> <strong>Attenzione!</strong> {{ flash_message|raw }}
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            {% for flash_message in app.flashes('danger') %}
                <div class="alert alert-dismissible alert-danger notice">
                    <i class="fa-solid fa-xmark"></i> <strong>Attenzione!</strong> {{ flash_message|raw }}
                    <button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
        </div>

        {% block body %}
            <div id="wrapper">
                <div id="divContent" class="clearfix">
                    <div id="header-trigger"><i class="bi-list"></i><i class="bi-x-lg"></i></div>

                    {# HEADER #}
                    {% block header %}
                        <header id="header">
                            <div id="header-wrap">
                                <div class="container">
                                    <div class="header-row">
                                        <div id="logo" class="p_tb_15p">
                                            <a href="{% block home_path %}{{ path('login') }}{% endblock %}">
                                                <img src="{{ asset(path_graphics ~ '/logo.svg') }}" alt="EBASM" style="max-height:40px;">
                                            </a>
                                        </div>
                                        <div class="primary-menu-trigger">
                                            <button class="cnvs-hamburger" type="button" title="Open Mobile Menu">
                                                <span class="cnvs-hamburger-box"><span class="cnvs-hamburger-inner"></span></span>
                                            </button>
                                        </div>
                                        <nav class="primary-menu on-click">
                                            <ul class="menu-container">
                                                {% block menu %}{% endblock %}
                                            </ul>
                                        </nav>
                                    </div>
                                </div>
                            </div>
                            <div class="header-wrap-clone"></div>
                        </header>
                    {% endblock %}

                    {% block page_title_section %}
                        <section class="page-title">
                            <div class="container">
                                <div class="page-title-row">
                                    <div class="page-title-content">
                                        <h3 class="m_b_none">{% block page_title %}{% endblock %}</h3>
                                    </div>
                                    <nav aria-label="breadcrumb">
                                        <ol class="breadcrumb">
                                            {% block breadcrumb %}{% endblock %}
                                        </ol>
                                    </nav>
                                </div>
                            </div>
                        </section>
                    {% endblock %}

                    {% block action_bar %}
                        <nav id="actionBar" class="navbar navbar-expand-md">
                            <div class="container">
                                <div class="mx-auto order-0">
                                    <button class="navbar-toggler button button-mini" type="button" data-bs-toggle="collapse" data-bs-target="#navCollapse">
                                        <span class="color_w">Elenco azioni</span>
                                    </button>
                                </div>
                                <div id="navCollapse" class="navbar-collapse collapse">
                                    <ul class="navbar-nav me-auto">
                                        {% block navbar_left %}{% endblock %}
                                    </ul>
                                    <ul class="navbar-nav">
                                        {% block navbar_right %}{% endblock %}
                                    </ul>
                                </div>
                            </div>
                        </nav>
                    {% endblock %}

                    {% block earlyJavascripts %}
                        <script type="text/javascript" src="{{ asset('js/jquery.js') }}"></script>
                        <script type="text/javascript" src="{{ asset('js/functions.js') }}"></script>
                        <script type="text/javascript" src="{{ asset('js/plugins.js') }}"></script>
                        <script>
                            // Canvas usa jsFolder/cssFolder relativi: su URL annidate fallisce a caricare i moduli lazy.
                            // Forziamo a path assoluti.
                            if (window.SEMICOLON && SEMICOLON.Core && SEMICOLON.Core.getOptions) {
                                SEMICOLON.Core.getOptions.jsFolder  = '{{ asset('js/') }}';
                                SEMICOLON.Core.getOptions.cssFolder = '{{ asset('css/') }}';
                            }
                        </script>
                    {% endblock %}

                    {# CONTENT #}
                    {% block content %}{% endblock %}

                    {# FOOTER #}
                    {% block footer %}
                        <footer id="footer">
                            <div id="copyrights">
                                <div class="container">
                                    <div class="row m_none align-items-center justify-content-between col-mb-30">
                                        <div class="col-12">
                                            <p class="m_b_none">Copyrights &copy; {{ "now"|date("Y") }} - Tutti i diritti riservati da EBASM.</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </footer>
                    {% endblock %}
                </div>
            </div>
        {% endblock %}

        {% block javascripts %}
            <script type="text/javascript" src="{{ asset('js/components/moment.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/components/datepicker.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/components/datepicker-it.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/components/daterangepicker.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/components/timepicker.js') }}"></script>
            <script type="text/javascript" src="{{ asset('js/personal/utilities.js') }}"></script>

            {# Scroll orizzontale su mobile: avvolge ogni .table in un .table-responsive. #}
            <script>
                (function () {
                    document.querySelectorAll('table.table').forEach(function (t) {
                        if (t.closest('.table-responsive')) return;
                        var wrap = document.createElement('div');
                        wrap.className = 'table-responsive';
                        t.parentNode.insertBefore(wrap, t);
                        wrap.appendChild(t);
                    });
                })();
            </script>

            {# Auto-dismiss flash notice (success/warning dopo 5s, danger dopo 8s) #}
            <script>
                (function () {
                    var container = document.getElementById('noticesContainer');
                    if (!container) return;
                    container.querySelectorAll('.alert.notice').forEach(function (el) {
                        var ms = el.classList.contains('alert-danger') ? 8000 : 5000;
                        setTimeout(function () {
                            var instance = bootstrap.Alert.getOrCreateInstance(el);
                            instance.close();
                        }, ms);
                    });
                })();
            </script>

            {% block page_javascripts %}{% endblock %}
        {% endblock %}

        <div id="divModals" class="clearfix">
            {% block modals %}{% endblock %}
        </div>
    </body>
</html>
