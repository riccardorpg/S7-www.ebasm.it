<!DOCTYPE html>
<html lang="it" data-theme="light">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="content-language" content="it">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    {% block robots %}<meta name="robots" content="index, follow">{% endblock %}
    <meta name="description" content="{% block description %}EBASM — il gestionale che semplifica il lavoro di aziende e professionisti.{% endblock %}">
    <meta name="author" content="R.P.G. Servizi Multimediali">
    <title>EBASM{% block title %}{% endblock %}</title>
    <link rel="canonical" href="{{ app.request.schemeAndHttpHost ~ app.request.pathInfo }}">
    <link rel="icon" type="image/svg+xml" href="{{ asset(path_graphics ~ '/logos/ebasm-favicon.svg') }}">
    <link rel="alternate icon" type="image/png" href="{{ asset(path_graphics ~ '/logos/ebasm-favicon-512.png') }}">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;500;600;700&family=PT+Serif:ital@0;1&display=swap">

    <link rel="stylesheet" href="{{ asset('css/style.css') }}">
    <link rel="stylesheet" href="{{ asset('css/font-icons.css') }}">
    <link rel="stylesheet" href="{{ asset('css/swiper.css') }}">
    <link rel="stylesheet" href="{{ asset('css/personal/classes.css') }}">
    <link rel="stylesheet" href="{{ asset('css/personal/custom.css') }}">
    <link rel="stylesheet" href="{{ asset('css/personal/themeOverride.css') }}">
    {% block page_stylesheets %}{% endblock %}

    <style>
        /* Colore primary = default Canvas (#1ABC9C) — placeholder, da decidere. */
        :root { --eb-brand:#1ABC9C; --eb-dark:#12181f; }
        #header.transparent-header:not(.sticky-header) { background:transparent; }
        /* Immagine di testata (1.2.1): sostituire il gradiente con una foto mettendo il file
           in public/images/graphics/hero.jpg e aggiungendo url('...') come primo layer. */
        .eb-hero { position:relative; min-height:88vh; display:flex; align-items:center;
            background:radial-gradient(1200px 600px at 75% 10%, rgba(0,161,156,.35), transparent 60%),
                       linear-gradient(135deg, #0b1620 0%, #12303a 55%, #0b1620 100%); color:#fff; }
        .eb-hero h1 { font-size:clamp(2rem,5vw,3.6rem); font-weight:700; line-height:1.1; }
        .eb-brand-color { color:var(--eb-brand); }
        .eb-section { padding:80px 0; }
        .eb-section-alt { background:#f6f8f9; }
        .eb-feature { text-align:center; padding:26px 18px; height:100%; }
        .eb-feature .eb-feature-icon { font-size:2.4rem; color:var(--eb-brand); margin-bottom:14px; display:inline-block; }
        .eb-pricing { border:1px solid #e6e9ec; border-radius:14px; padding:34px 26px; text-align:center; height:100%; background:#fff; }
        .eb-pricing.featured { border-color:var(--eb-brand); box-shadow:0 12px 40px rgba(0,161,156,.15); }
        .eb-price { font-size:2.6rem; font-weight:700; color:var(--eb-dark); }
        .eb-price small { font-size:1rem; font-weight:400; color:#7a828a; }
        .eb-footer { background:var(--eb-dark); color:#aab3bc; padding:50px 0 30px; }
        .eb-footer a { color:#cfd6dd; text-decoration:none; }
        .eb-footer a:hover { color:var(--eb-brand); }
        .eb-video-wrap { position:relative; padding-top:56.25%; border-radius:14px; overflow:hidden; box-shadow:0 12px 40px rgba(0,0,0,.18); }
        .eb-video-wrap iframe, .eb-video-wrap video { position:absolute; inset:0; width:100%; height:100%; border:0; }
    </style>

    {# ===== 5.1 IUBENDA — banner cookie / consent (attivo solo se configurato) ===== #}
    {% if iubenda_site_id and iubenda_cookie_policy_id %}
        <script type="text/javascript">
            var _iub = _iub || [];
            _iub.csConfiguration = {
                siteId: {{ iubenda_site_id }},
                cookiePolicyId: {{ iubenda_cookie_policy_id }},
                lang: "it",
                storage: { useSiteId: true }
            };
        </script>
        <script type="text/javascript" src="https://cs.iubenda.com/autoblocking/{{ iubenda_site_id }}.js"></script>
        <script type="text/javascript" src="//cdn.iubenda.com/cs/iubenda_cs.js" charset="UTF-8" async></script>
    {% endif %}
</head>
<body id="body" class="stretched">
    <div id="wrapper" class="clearfix">

        {# ===== 1.1 MENU DI NAVIGAZIONE ===== #}
        <header id="header" class="full-header sticky-header" data-sticky-shrink="false">
            <div id="header-wrap">
                <div class="container">
                    <div class="header-row justify-content-between">
                        <div id="logo" class="py-2">
                            <a href="{{ path('homepage') }}"><img src="{{ asset(path_graphics ~ '/logo-mono-white.svg') }}" alt="EBASM" style="max-height:100px;"></a>
                        </div>

                        <div id="primary-menu-trigger">
                            <button class="cnvs-hamburger" type="button" title="Menu">
                                <span class="cnvs-hamburger-box"><span class="cnvs-hamburger-inner"></span></span>
                            </button>
                        </div>

                        <nav class="primary-menu with-arrows">
                            <ul class="menu-container">
                                <li class="menu-item"><a class="menu-link" href="{{ path('homepage') }}#progetto"><div>Il progetto</div></a></li>
                                <li class="menu-item"><a class="menu-link" href="{{ path('homepage') }}#punti-di-forza"><div>Punti di forza</div></a></li>
                                <li class="menu-item"><a class="menu-link" href="{{ path('homepage') }}#pricing"><div>Prezzi</div></a></li>
                                <li class="menu-item"><a class="menu-link" href="{{ path('homepage') }}#demo"><div>Demo</div></a></li>
                                <li class="menu-item"><a class="menu-link" href="{{ path('homepage') }}#contatti"><div>Contatti</div></a></li>
                                <li class="menu-item ms-lg-3">
                                    <a class="menu-link" href="{{ path('login') }}">
                                        <div><i class="bi-person-circle"></i> Area riservata</div>
                                    </a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </header>

        <div id="noticesContainer" class="notices">
            {% for msg in app.flashes('success') %}<div class="alert alert-success alert-dismissible notice"><i class="fa-solid fa-thumbs-up"></i> {{ msg|raw }}<button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button></div>{% endfor %}
            {% for msg in app.flashes('warning') %}<div class="alert alert-warning alert-dismissible notice"><i class="fa-solid fa-triangle-exclamation"></i> {{ msg|raw }}<button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button></div>{% endfor %}
            {% for msg in app.flashes('danger') %}<div class="alert alert-danger alert-dismissible notice"><i class="fa-solid fa-circle-exclamation"></i> {{ msg|raw }}<button type="button" class="btn-close btn-sm" data-bs-dismiss="alert"></button></div>{% endfor %}
        </div>

        {% block content %}{% endblock %}

        {# ===== 1.8 PIE DI PAGINA ===== #}
        <footer id="footer" class="eb-footer">
            <div class="container">
                <div class="row g-4">
                    <div class="col-lg-5">
                        <img src="{{ asset(path_graphics ~ '/logo.svg') }}" alt="EBASM" style="max-height:56px;" class="mb-3">
                        <p class="font_13">EBASM — il gestionale che semplifica il lavoro quotidiano di aziende e professionisti.</p>
                    </div>
                    <div class="col-lg-4 col-6">
                        <h6 class="text-white text-uppercase font_13 mb-3">Informazioni legali</h6>
                        <ul class="list-unstyled font_13">
                            {# 5.2 documenti legali: IUBENDA se configurato, altrimenti pagine interne #}
                            {% if iubenda_privacy_policy_id %}
                                <li class="mb-2"><a href="https://www.iubenda.com/privacy-policy/{{ iubenda_privacy_policy_id }}" class="iubenda-white iubenda-noiframe iubenda-embed iubenda-nostyle no-brand" title="Privacy Policy">Normativa privacy</a></li>
                                <li class="mb-2"><a href="https://www.iubenda.com/privacy-policy/{{ iubenda_privacy_policy_id }}/cookie-policy" class="iubenda-white iubenda-noiframe iubenda-embed iubenda-nostyle no-brand" title="Cookie Policy">Normativa cookie</a></li>
                            {% else %}
                                <li class="mb-2"><a href="{{ path('legal_privacy') }}">Normativa privacy</a></li>
                                <li class="mb-2"><a href="{{ path('legal_cookie') }}">Normativa cookie</a></li>
                            {% endif %}
                            {% if iubenda_terms_id %}
                                <li class="mb-2"><a href="https://www.iubenda.com/termini-e-condizioni/{{ iubenda_terms_id }}" class="iubenda-white iubenda-noiframe iubenda-embed iubenda-nostyle no-brand" title="Termini e Condizioni">Termini e condizioni di utilizzo</a></li>
                            {% else %}
                                <li class="mb-2"><a href="{{ path('legal_terms') }}">Termini e condizioni di utilizzo</a></li>
                            {% endif %}
                        </ul>
                    </div>
                    <div class="col-lg-3 col-6">
                        <h6 class="text-white text-uppercase font_13 mb-3">Contatti</h6>
                        <ul class="list-unstyled font_13">
                            <li class="mb-2"><a href="{{ path('homepage') }}#contatti">Richiedi informazioni</a></li>
                            <li class="mb-2"><a href="{{ path('homepage') }}#contatti">Richiedi la demo</a></li>
                            <li class="mb-2"><a href="{{ path('login') }}">Area riservata</a></li>
                        </ul>
                    </div>
                </div>
                <hr style="border-color:rgba(255,255,255,.1);">
                <div class="font_12 text-center" style="color:#7a828a;">© {{ 'now'|date('Y') }} EBASM — Tutti i diritti riservati · P.IVA 00000000000</div>
            </div>
        </footer>
    </div>

    <div id="gotoTop" class="uil uil-angle-up"></div>

    <script src="{{ asset('js/jquery.js') }}"></script>
    <script src="{{ asset('js/functions.js') }}"></script>
    <script src="{{ asset('js/plugins.js') }}"></script>
    <script>
        if (window.SEMICOLON && SEMICOLON.Core && SEMICOLON.Core.getOptions) {
            SEMICOLON.Core.getOptions.jsFolder  = '{{ asset('js/') }}';
            SEMICOLON.Core.getOptions.cssFolder = '{{ asset('css/') }}';
        }
    </script>
    {# IUBENDA — embed loader per i documenti legali (privacy/cookie/termini) #}
    {% if iubenda_privacy_policy_id or iubenda_terms_id %}
        <script type="text/javascript">
            (function (w, d) {
                var loader = function () {
                    var s = d.createElement("script"), tag = d.getElementsByTagName("script")[0];
                    s.src = "https://cdn.iubenda.com/iubenda.js";
                    tag.parentNode.insertBefore(s, tag);
                };
                if (w.addEventListener) { w.addEventListener("load", loader, false); }
                else if (w.attachEvent) { w.attachEvent("onload", loader); }
                else { w.onload = loader; }
            })(window, document);
        </script>
    {% endif %}

    {% block page_javascripts %}{% endblock %}
</body>
</html>
