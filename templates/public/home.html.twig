{% extends 'public/layout.html.twig' %}

{% block title %} - Il gestionale per aziende e professionisti{% endblock %}

{% block content %}

    {# ===================== 1.2 SLIDER INIZIALE ===================== #}
    <section class="eb-hero">
        <div class="container">
            <div class="row">
                <div class="col-lg-8">
                    {# 1.2.2 Slogan #}
                    <span class="badge bg-white text-dark mb-3 px-3 py-2 rounded-pill">Gestionale in cloud · Multi-tenant</span>
                    <h1 class="mb-3">Gestisci tutto il tuo lavoro <span class="eb-brand-color">in un unico posto</span></h1>
                    <p class="lead text-white-50 mb-4" style="max-width:640px;">
                        EBASM è la piattaforma che semplifica l'operatività quotidiana di aziende e professionisti:
                        veloce, sicura e accessibile ovunque. <em>(slogan placeholder — da rifinire)</em>
                    </p>
                    <div class="d-flex flex-wrap gap-3">
                        {# 1.2.3 CTA Video demo #}
                        <a href="#demo" class="button button-3d button-rounded button-large m-0" style="background:var(--eb-brand);">
                            <i class="bi-play-circle"></i> Guarda il video demo
                        </a>
                        {# 1.2.4 CTA Contattaci #}
                        <a href="#contatti" class="button button-3d button-rounded button-large button-light m-0" style="color:#12181f;">
                            <i class="bi-chat-dots"></i> Contattaci
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== 1.3 IL PROGETTO ===================== #}
    <section id="progetto" class="eb-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="mb-2">Il progetto</h2>
                <p class="text-muted" style="max-width:720px;margin:0 auto;">Da dove nasce EBASM e dove vuole arrivare.</p>
            </div>
            <div class="row g-4">
                {# 1.3.1 Contesto #}
                <div class="col-lg-4">
                    <div class="feature-box fbox-plain">
                        <div class="fbox-icon"><i class="bi-globe eb-brand-color"></i></div>
                        <div class="fbox-content">
                            <h3>Contesto</h3>
                            <p class="text-muted">Descrizione del contesto di mercato e delle esigenze a cui EBASM risponde. <em>(placeholder)</em></p>
                        </div>
                    </div>
                </div>
                {# 1.3.2 Mission #}
                <div class="col-lg-4">
                    <div class="feature-box fbox-plain">
                        <div class="fbox-icon"><i class="bi-bullseye eb-brand-color"></i></div>
                        <div class="fbox-content">
                            <h3>Mission</h3>
                            <p class="text-muted">La missione del progetto: cosa vogliamo fare per i nostri clienti, ogni giorno. <em>(placeholder)</em></p>
                        </div>
                    </div>
                </div>
                {# 1.3.3 Vision #}
                <div class="col-lg-4">
                    <div class="feature-box fbox-plain">
                        <div class="fbox-icon"><i class="bi-eye eb-brand-color"></i></div>
                        <div class="fbox-content">
                            <h3>Vision</h3>
                            <p class="text-muted">La visione a lungo termine: dove vogliamo portare EBASM e il suo ecosistema. <em>(placeholder)</em></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== 1.4 PUNTI DI FORZA ===================== #}
    <section id="punti-di-forza" class="eb-section eb-section-alt">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="mb-2">Punti di forza</h2>
                <p class="text-muted">Perché scegliere EBASM.</p>
            </div>
            <div class="row g-4">
                {% set strengths = [
                    {icon: 'bi-cloud-check', name: 'Tutto in cloud', text: 'Accedi ai tuoi dati ovunque, senza installazioni.'},
                    {icon: 'bi-shield-lock', name: 'Dati al sicuro', text: 'Backup automatici e separazione dei dati per ogni cliente.'},
                    {icon: 'bi-lightning-charge', name: 'Veloce e semplice', text: 'Interfaccia intuitiva, pensata per il lavoro reale.'},
                    {icon: 'bi-people', name: 'Multi-utente', text: 'Gestisci ruoli e permessi del tuo team con pochi clic.'},
                    {icon: 'bi-graph-up-arrow', name: 'Report in tempo reale', text: 'Tieni sotto controllo i numeri che contano.'},
                    {icon: 'bi-headset', name: 'Assistenza dedicata', text: 'Un supporto reale al tuo fianco quando serve.'}
                ] %}
                {% for s in strengths %}
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm eb-feature">
                            {# 1.4.1.1 Icona · 1.4.1.2 Nome · 1.4.1.3 Breve frase #}
                            <div class="eb-feature-icon"><i class="{{ s.icon }}"></i></div>
                            <h4 class="mb-2">{{ s.name }}</h4>
                            <p class="text-muted m-0">{{ s.text }}</p>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    {# ===================== 1.5 PRICING ===================== #}
    <section id="pricing" class="eb-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="mb-2">Prezzi</h2>
                <p class="text-muted">Un costo base chiaro, espandibile in base alle tue esigenze. <em>(prezzi placeholder)</em></p>
            </div>
            <div class="row g-4 justify-content-center">
                {# 1.5.1 Costo base del software #}
                <div class="col-lg-5">
                    <div class="eb-pricing featured">
                        <h4 class="text-uppercase" style="letter-spacing:.5px;">Licenza base</h4>
                        <div class="eb-price my-3">€ 49 <small>/ mese</small></div>
                        <ul class="list-unstyled text-start mx-auto" style="max-width:280px;">
                            <li class="mb-2"><i class="bi-check-circle-fill eb-brand-color"></i> Accesso completo al gestionale</li>
                            <li class="mb-2"><i class="bi-check-circle-fill eb-brand-color"></i> Utenti illimitati del team</li>
                            <li class="mb-2"><i class="bi-check-circle-fill eb-brand-color"></i> 5 GB di spazio incluso</li>
                            <li class="mb-2"><i class="bi-check-circle-fill eb-brand-color"></i> Aggiornamenti e assistenza</li>
                        </ul>
                        <a href="#contatti" class="button button-3d button-rounded m-0" style="background:var(--eb-brand);">Richiedi la demo</a>
                    </div>
                </div>
                {# 1.5.2 Pacchetti di espansione di memoria #}
                <div class="col-lg-5">
                    <div class="eb-pricing">
                        <h4 class="text-uppercase" style="letter-spacing:.5px;">Espansioni di memoria</h4>
                        <p class="text-muted">Aggiungi spazio quando ti serve.</p>
                        <table class="table align-middle mt-3">
                            <tbody>
                                <tr><td class="text-start">+ 10 GB</td><td class="text-end fw-bold">€ 9 / mese</td></tr>
                                <tr><td class="text-start">+ 50 GB</td><td class="text-end fw-bold">€ 29 / mese</td></tr>
                                <tr><td class="text-start">+ 100 GB</td><td class="text-end fw-bold">€ 49 / mese</td></tr>
                                <tr><td class="text-start">+ 500 GB</td><td class="text-end fw-bold">€ 149 / mese</td></tr>
                            </tbody>
                        </table>
                        <a href="#contatti" class="button button-3d button-rounded button-dark m-0">Parla con noi</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== 1.6 GUARDA LA DEMO ===================== #}
    <section id="demo" class="eb-section eb-section-alt">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="mb-2">Guarda la demo</h2>
                <p class="text-muted">Un video di 2 minuti per scoprire EBASM in azione. <em>(video placeholder)</em></p>
            </div>
            <div class="row justify-content-center">
                <div class="col-lg-9">
                    {# 1.6.1 Video demo di utilizzo del software #}
                    <div class="eb-video-wrap">
                        {# Sostituire con l'embed reale (YouTube/Vimeo) o un <video src>. #}
                        <iframe src="https://www.youtube.com/embed/dQw4w9WgXcQ" title="Video demo EBASM" allowfullscreen loading="lazy"></iframe>
                    </div>
                </div>
            </div>
        </div>
    </section>

    {# ===================== 1.7 CONTATTI ===================== #}
    <section id="contatti" class="eb-section">
        <div class="container">
            <div class="text-center mb-5">
                <h2 class="mb-2">Contatti</h2>
                <p class="text-muted">Scrivici o richiedi subito la demo gratuita di 30 giorni.</p>
            </div>
            <div class="row g-5">

                {# ---- 1.7.1 FORM DI RICHIESTA CONTATTO ---- #}
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-body p-4">
                            <h4 class="mb-3"><i class="bi-envelope eb-brand-color"></i> Richiedi informazioni</h4>
                            <form method="post" action="{{ path('contact_submit') }}" novalidate>
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('contact') }}">
                                <div class="row g-3">
                                    <div class="col-md-6"><label class="form-label">Nome *</label><input type="text" name="nome" class="form-control" required></div>
                                    <div class="col-md-6"><label class="form-label">Cognome *</label><input type="text" name="cognome" class="form-control" required></div>
                                    <div class="col-12"><label class="form-label">E-mail *</label><input type="email" name="email" class="form-control" required></div>
                                    <div class="col-12"><label class="form-label">Messaggio *</label><textarea name="messaggio" rows="4" class="form-control" required></textarea></div>
                                    <div class="col-12">
                                        {# 1.7.1.5 Google reCaptcha (inserire site key reale) #}
                                        <div class="g-recaptcha" data-sitekey="RECAPTCHA_SITE_KEY"></div>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" class="button button-3d button-rounded m-0" style="background:var(--eb-brand);">Invia richiesta</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>

                {# ---- 1.7.2 RICHIEDI LA DEMO PER 30 GIORNI ---- #}
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm h-100" style="border-top:3px solid var(--eb-brand) !important;">
                        <div class="card-body p-4">
                            <h4 class="mb-3"><i class="bi-rocket-takeoff eb-brand-color"></i> Richiedi la demo per 30 giorni</h4>
                            <form method="post" action="{{ path('demo_request_submit') }}" novalidate id="demoForm">
                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('demo') }}">
                                <div class="row g-3">
                                    {# 1.7.2.1 Tipo di account #}
                                    <div class="col-12">
                                        <label class="form-label d-block">Tipo di account *</label>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="account_type" id="acc_az" value="aziendale" checked>
                                            <label class="form-check-label" for="acc_az">Aziendale</label>
                                        </div>
                                        <div class="form-check form-check-inline">
                                            <input class="form-check-input" type="radio" name="account_type" id="acc_pro" value="professionista">
                                            <label class="form-check-label" for="acc_pro">Professionista</label>
                                        </div>
                                    </div>
                                    {# 1.7.2.2 / 1.7.2.3 email + verifica #}
                                    <div class="col-md-6"><label class="form-label">E-mail per la registrazione *</label><input type="email" name="email" class="form-control" required></div>
                                    <div class="col-md-6"><label class="form-label">Verifica e-mail *</label><input type="email" name="email_confirm" class="form-control" required></div>
                                    {# 1.7.2.4 ragione sociale / nome e cognome #}
                                    <div class="col-12"><label class="form-label" id="labelRagioneSociale">Ragione sociale *</label><input type="text" name="ragione_sociale" class="form-control" required></div>
                                    {# 1.7.2.5 / 1.7.2.6 indirizzo + civico #}
                                    <div class="col-md-9"><label class="form-label">Indirizzo *</label><input type="text" name="indirizzo" class="form-control" required></div>
                                    <div class="col-md-3"><label class="form-label">Civico *</label><input type="text" name="civico" class="form-control" required></div>
                                    {# 1.7.2.7 / 1.7.2.8 città + CAP #}
                                    <div class="col-md-8"><label class="form-label">Città *</label><input type="text" name="citta" class="form-control" required></div>
                                    <div class="col-md-4"><label class="form-label">CAP *</label><input type="text" name="cap" class="form-control" maxlength="5" required></div>
                                    {# 1.7.2.9 / 1.7.2.10 SDI + PEC #}
                                    <div class="col-md-6"><label class="form-label">Codice SDI</label><input type="text" name="sdi" class="form-control" maxlength="7"></div>
                                    <div class="col-md-6"><label class="form-label">PEC</label><input type="email" name="pec" class="form-control"></div>
                                    {# 1.7.2.11 Google reCaptcha #}
                                    <div class="col-12"><div class="g-recaptcha" data-sitekey="RECAPTCHA_SITE_KEY"></div></div>
                                    <div class="col-12">
                                        <button type="submit" class="button button-3d button-rounded button-dark m-0">Attiva la demo gratuita</button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% block page_javascripts %}
    {# Google reCaptcha: abilitare inserendo le chiavi reali e la verifica server-side. #}
    <script src="https://www.google.com/recaptcha/api.js" async defer></script>
    <script>
        (function () {
            // 1.7.2.4: l'etichetta cambia in base al tipo di account.
            var form = document.getElementById('demoForm');
            if (!form) return;
            var label = document.getElementById('labelRagioneSociale');
            form.querySelectorAll('input[name="account_type"]').forEach(function (r) {
                r.addEventListener('change', function () {
                    label.textContent = (this.value === 'professionista') ? 'Nome e cognome *' : 'Ragione sociale *';
                });
            });
        })();
    </script>
{% endblock %}
